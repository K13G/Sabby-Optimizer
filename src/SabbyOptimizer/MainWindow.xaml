<Window x:Class="PCTweaker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Sabby Optimizer"
        Icon="Resources/AppIcon.ico"
        Width="1240"
        Height="800"
        MinWidth="1000"
        MinHeight="650"
        ResizeMode="CanResize"
        WindowStyle="None"
        SizeToContent="Manual"
        Background="{DynamicResource AppBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Text"
        WindowStartupLocation="CenterScreen"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        TextOptions.TextHintingMode="Fixed">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="0,6,6,6"
                            CornerRadius="14"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Grid x:Name="RootLayout" PreviewMouseMove="RootLayout_PreviewMouseMove" MouseLeave="RootLayout_MouseLeave">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="SidebarColumn" Width="58" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="42" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Crisp custom chrome: vector glyphs avoid font-dependent/squashed caption icons. -->
        <Border Grid.Row="0" Grid.ColumnSpan="2" Panel.ZIndex="1000"
                Background="{DynamicResource SidebarBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False">
                    <TextBlock Text="S" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource BrandAccentBrush}"/>
                    <TextBlock Text="O" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Sabby Optimizer" Margin="9,0,0,0" FontSize="11.5" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Stretch">
                    <Button Width="52" Height="40" Padding="0" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                            Click="MinimizeButton_Click" ToolTip="Minimize" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Root" Background="Transparent">
                                    <Viewbox Width="13" Height="13">
                                        <Canvas Width="13" Height="13">
                                            <Path Data="M 2,9.5 L 11,9.5" Stroke="{TemplateBinding Foreground}" StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#20242A"/></Trigger>
                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.72"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Width="52" Height="40" Padding="0" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                            Click="MaximizeButton_Click" ToolTip="Fullscreen / Restore" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Root" Background="Transparent">
                                    <Viewbox Width="13" Height="13">
                                        <Canvas Width="13" Height="13">
                                            <Rectangle Width="8.5" Height="8.5" Canvas.Left="2.25" Canvas.Top="2.25"
                                                       Stroke="{TemplateBinding Foreground}" StrokeThickness="1.2"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Root" Property="Background" Value="#20242A"/></Trigger>
                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Opacity" Value="0.72"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button Width="52" Height="40" Padding="0" BorderThickness="0" Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}"
                            Click="ChromeCloseButton_Click" ToolTip="Close" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Root" Background="Transparent">
                                    <Viewbox Width="13" Height="13">
                                        <Canvas Width="13" Height="13">
                                            <Path Data="M 2.5,2.5 L 10.5,10.5 M 10.5,2.5 L 2.5,10.5"
                                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1.35"
                                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                        </Canvas>
                                    </Viewbox>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Root" Property="Background" Value="#C42B1C"/>
                                        <Setter Property="Foreground" Value="White"/>
                                    </Trigger>
                                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="Root" Property="Background" Value="#9D1F15"/></Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Tiny screen-edge trigger that never covers the navigation icons. -->
        <Border x:Name="SidebarEdgeHotspot"
                Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                Panel.ZIndex="2100"
                Width="22"
                HorizontalAlignment="Left"
                Background="Transparent"
                MouseEnter="SidebarEdgeHotspot_MouseEnter" />

        <!-- Compact icon rail that expands only while hovered. -->
        <Border x:Name="SidebarHost"
                Grid.Row="1"
                Grid.Column="0"
                Grid.ColumnSpan="2"
                Panel.ZIndex="1900"
                Width="58"
                HorizontalAlignment="Left"
                MouseEnter="SidebarHost_MouseEnter"
                MouseLeave="SidebarHost_MouseLeave"
                Background="{DynamicResource SidebarBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,1,0"
                ClipToBounds="True"
                Tag="False">
            <Grid>
                <!-- Blood Bath lives over nav icons, but under the Settings control. Every drop starts above the clipped rail. -->
                <Canvas Panel.ZIndex="0"
                        IsHitTestVisible="False"
                        Visibility="Collapsed"
                        Opacity="{DynamicResource BloodBathEffectOpacity}"
                        ClipToBounds="True">
                    <Grid x:Name="SideDrop1" Canvas.Left="7" Canvas.Top="0" Width="11" Height="20" Opacity="0.84">
                        <Grid.RenderTransform><TranslateTransform Y="-320" /></Grid.RenderTransform>
                        <Path Stretch="Fill" Fill="{DynamicResource AccentBrush}" Data="M5.5,0 C4.5,3.7 1,7.2 0.6,11.7 C0.2,16.7 2.7,20 5.5,20 C8.3,20 10.8,16.7 10.4,11.7 C10,7.2 6.5,3.7 5.5,0 Z" />
                        <Ellipse Width="2" Height="3.4" Margin="2.7,4.5,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="#32FFFFFF" />
                    </Grid>
                    <Grid x:Name="SideDrop2" Canvas.Left="22" Canvas.Top="0" Width="8" Height="15" Opacity="0.72">
                        <Grid.RenderTransform><TranslateTransform Y="-320" /></Grid.RenderTransform>
                        <Path Stretch="Fill" Fill="{DynamicResource AccentBrush}" Data="M4,0 C3.2,2.8 0.7,5.4 0.4,8.7 C0.1,12.4 1.9,15 4,15 C6.1,15 7.9,12.4 7.6,8.7 C7.3,5.4 4.8,2.8 4,0 Z" />
                    </Grid>
                    <Grid x:Name="SideDrop3" Canvas.Right="7" Canvas.Top="0" Width="12" Height="22" Opacity="0.86">
                        <Grid.RenderTransform><TranslateTransform Y="-320" /></Grid.RenderTransform>
                        <Path Stretch="Fill" Fill="{DynamicResource AccentBrush}" Data="M6,0 C4.9,4.1 1.1,7.7 0.6,12.8 C0.2,18.3 3,22 6,22 C9,22 11.8,18.3 11.4,12.8 C10.9,7.7 7.1,4.1 6,0 Z" />
                        <Ellipse Width="2.1" Height="3.6" Margin="3,4.9,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Fill="#36FFFFFF" />
                    </Grid>
                    <Grid x:Name="SideDrop4" Canvas.Right="23" Canvas.Top="0" Width="7" Height="13" Opacity="0.68">
                        <Grid.RenderTransform><TranslateTransform Y="-320" /></Grid.RenderTransform>
                        <Path Stretch="Fill" Fill="{DynamicResource AccentBrush}" Data="M3.5,0 C2.8,2.4 0.6,4.7 0.35,7.5 C0.1,10.8 1.7,13 3.5,13 C5.3,13 6.9,10.8 6.65,7.5 C6.4,4.7 4.2,2.4 3.5,0 Z" />
                    </Grid>
                </Canvas>

                <Grid Panel.ZIndex="10">
                    <Grid.RowDefinitions>
                        <!-- These two rows always keep their height so nav icons never move when the rail expands. -->
                        <RowDefinition Height="84" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="0" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Panel.ZIndex="50" Margin="17,18,12,0" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
                        <StackPanel x:Name="CollapsedBrandPanel" Orientation="Horizontal" VerticalAlignment="Top" Opacity="1">
                            <TextBlock Text="S" FontSize="20" LineHeight="24" LineStackingStrategy="BlockLineHeight" FontWeight="SemiBold" Foreground="{DynamicResource BrandAccentBrush}" />
                            <TextBlock Text="O" FontSize="20" LineHeight="24" LineStackingStrategy="BlockLineHeight" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                        </StackPanel>

                        <StackPanel x:Name="SidebarBrandPanel" VerticalAlignment="Top" Opacity="0">
                            <StackPanel Orientation="Horizontal" Height="24">
                                <TextBlock Text="SABBY" FontSize="20" LineHeight="24" LineStackingStrategy="BlockLineHeight" FontWeight="SemiBold" Foreground="{DynamicResource BrandAccentBrush}" />
                                <TextBlock Text="OPTIMIZER" Margin="10,0,0,0" FontSize="20" LineHeight="24" LineStackingStrategy="BlockLineHeight" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" />
                            </StackPanel>
                            <TextBlock Text="Windows tuning, your way" Margin="0,5,0,0" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" />
                        </StackPanel>
                    </Grid>

                    <Border Grid.Row="1" Height="0" Visibility="Collapsed" />

                    <ListBox Grid.Row="2"
                             Tag="{Binding ElementName=SidebarHost, Path=Tag}"
                             ItemsSource="{Binding NavigationItems}"
                             SelectedItem="{Binding SelectedSidebarItem, Mode=TwoWay}"
                             ScrollViewer.VerticalScrollBarVisibility="Hidden"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             Style="{StaticResource SidebarListBoxStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Height="46">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="58" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding Glyph}"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               VerticalAlignment="Center"
                                               HorizontalAlignment="Center"
                                               ToolTip="{Binding Label}" />
                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Label}"
                                               Margin="8,0,14,0"
                                               VerticalAlignment="Center"
                                               FontSize="12.5"
                                               FontWeight="Medium"
                                               TextTrimming="CharacterEllipsis"
                                               IsHitTestVisible="False"
                                               Opacity="1" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <!-- Compact footer actions stay visible in fullscreen and remain side-by-side. -->
                    <Border Grid.Row="3" Panel.ZIndex="150" Height="0" Visibility="Collapsed"
                            Background="{DynamicResource SidebarBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
                        <Grid Width="216" HorizontalAlignment="Left">
                            <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center">
                                <Button Command="{Binding OpenSettingsCommand}"
                                        Width="40" Height="40" MinHeight="40" Padding="0"
                                        Background="Transparent" BorderThickness="0" ToolTip="Settings">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Root" Width="40" Height="40" CornerRadius="20" Background="Transparent">
                                                <Border x:Name="IconBubble" Width="34" Height="34" CornerRadius="17"
                                                        Background="{DynamicResource SurfaceHoverBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                    <Setter TargetName="IconBubble" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsSettingsSelected}" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                                                    <Setter TargetName="IconBubble" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <Button Command="{Binding OpenCreditsCommand}"
                                        Width="40" Height="40" MinHeight="40" Padding="0" Margin="8,0,0,0"
                                        Background="Transparent" BorderThickness="0" ToolTip="Credits">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Root" Width="40" Height="40" CornerRadius="20" Background="Transparent">
                                                <Border x:Name="IconBubble" Width="34" Height="34" CornerRadius="17"
                                                        Background="{DynamicResource SurfaceHoverBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                </Border>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                                    <Setter TargetName="IconBubble" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                </Trigger>
                                                <DataTrigger Binding="{Binding IsCreditsSelected}" Value="True">
                                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                                                    <Setter TargetName="IconBubble" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                </DataTrigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- Settings/Credits live outside the clipped hover rail so both stay visible at every window size. -->
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2"
                Panel.ZIndex="2000"
                Width="96" Height="48"
                Margin="8,0,0,22"
                HorizontalAlignment="Left"
                VerticalAlignment="Bottom"
                Background="Transparent"
                BorderThickness="0"
                CornerRadius="0"
                ClipToBounds="False">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button Command="{Binding OpenSettingsCommand}"
                        Width="42" Height="42" MinHeight="42" Padding="0"
                        Background="Transparent" BorderThickness="0"
                        ToolTip="Settings"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root" Width="40" Height="40" CornerRadius="20" Background="Transparent">
                                <Border x:Name="Bubble" Width="34" Height="34" CornerRadius="17"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                    <Setter TargetName="Bubble" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSettingsSelected}" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                                    <Setter TargetName="Bubble" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Command="{Binding OpenCreditsCommand}"
                        Width="42" Height="42" MinHeight="42" Padding="0" Margin="8,0,0,0"
                        Background="Transparent" BorderThickness="0"
                        ToolTip="Credits"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ElementName=SidebarHost, Path=Tag}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Root" Width="40" Height="40" CornerRadius="20" Background="Transparent">
                                <Border x:Name="Bubble" Width="34" Height="34" CornerRadius="17"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                                        HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource SurfaceHoverBrush}"/>
                                    <Setter TargetName="Bubble" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsCreditsSelected}" Value="True">
                                    <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                                    <Setter TargetName="Bubble" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Border>

        <Grid x:Name="WorkspaceHost" Grid.Row="1" Grid.Column="1" Panel.ZIndex="10" ClipToBounds="True" RenderTransformOrigin="0,0">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="WorkspaceScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="WorkspaceShift" X="0" />
                </TransformGroup>
            </Grid.RenderTransform>
            <Grid x:Name="MainBloodLayer"
                  Panel.ZIndex="0"
                  IsHitTestVisible="False"
                  Visibility="{DynamicResource BloodBathOverlayVisibility}"
                  Opacity="{DynamicResource BloodBathEffectOpacity}"
                  ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>
                <Grid x:Name="MainDrop1" Grid.Column="0" Width="9" Height="17" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0.68">
                    <Grid.RenderTransform><TranslateTransform Y="-420" /></Grid.RenderTransform>
                    <Path Stretch="Fill" Fill="{DynamicResource AccentBrush}" Data="M4.5,0 C3.6,3.1 0.8,6 0.45,9.9 C0.15,14.1 2.2,17 4.5,17 C6.8,17 8.85,14.1 8.55,9.9 C8.2,6 5.4,3.1 4.5,0 Z"/>
                </Grid>
                <Grid x:Name="MainDrop2" Grid.Column="1" Width="12" Height="22" HorizontalAlignment="Right" Margin="0,0,34,0" VerticalAlignment="Top" Opacity="0.76">
                    <Grid.RenderTransform><TranslateTransform Y="-420" /></Grid.RenderTransform>
                    <Path Stretch="Fill" Fill="{DynamicResource AccentBrush}" Data="M6,0 C4.9,4.1 1.1,7.7 0.6,12.8 C0.2,18.3 3,22 6,22 C9,22 11.8,18.3 11.4,12.8 C10.9,7.7 7.1,4.1 6,0 Z"/>
                </Grid>
                <Grid x:Name="MainDrop3" Grid.Column="2" Width="8" Height="15" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0.62">
                    <Grid.RenderTransform><TranslateTransform Y="-420" /></Grid.RenderTransform>
                    <Path Stretch="Fill" Fill="{DynamicResource AccentBrush}" Data="M4,0 C3.2,2.8 0.7,5.4 0.4,8.7 C0.1,12.4 1.9,15 4,15 C6.1,15 7.9,12.4 7.6,8.7 C7.3,5.4 4.8,2.8 4,0 Z"/>
                </Grid>
                <Grid x:Name="MainDrop4" Grid.Column="3" Width="11" Height="20" HorizontalAlignment="Left" Margin="42,0,0,0" VerticalAlignment="Top" Opacity="0.72">
                    <Grid.RenderTransform><TranslateTransform Y="-420" /></Grid.RenderTransform>
                    <Path Stretch="Fill" Fill="{DynamicResource AccentBrush}" Data="M5.5,0 C4.5,3.7 1,7.2 0.6,11.7 C0.2,16.7 2.7,20 5.5,20 C8.3,20 10.8,16.7 10.4,11.7 C10,7.2 6.5,3.7 5.5,0 Z"/>
                </Grid>
                <Grid x:Name="MainDrop5" Grid.Column="4" Width="7" Height="13" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0.60">
                    <Grid.RenderTransform><TranslateTransform Y="-420" /></Grid.RenderTransform>
                    <Path Stretch="Fill" Fill="{DynamicResource AccentBrush}" Data="M3.5,0 C2.8,2.4 0.6,4.7 0.35,7.5 C0.1,10.8 1.7,13 3.5,13 C5.3,13 6.9,10.8 6.65,7.5 C6.4,4.7 4.2,2.4 3.5,0 Z"/>
                </Grid>
                <Grid x:Name="MainDrop6" Grid.Column="5" Width="13" Height="24" HorizontalAlignment="Center" VerticalAlignment="Top" Opacity="0.68">
                    <Grid.RenderTransform><TranslateTransform Y="-420" /></Grid.RenderTransform>
                    <Path Stretch="Fill" Fill="{DynamicResource AccentBrush}" Data="M6.5,0 C5.3,4.4 1.2,8.3 0.7,13.9 C0.2,19.8 3.1,24 6.5,24 C9.9,24 12.8,19.8 12.3,13.9 C11.8,8.3 7.7,4.4 6.5,0 Z"/>
                </Grid>
            </Grid>

            <Grid Panel.ZIndex="10">
                <Grid.RowDefinitions>
                    <RowDefinition Height="72" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" MinHeight="72" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid Margin="24,0" VerticalAlignment="Center">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center" Margin="0,2,0,0">
                                <TextBlock Text="{Binding CurrentPageTitle}" FontSize="20" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding CurrentPageSubtitle}" Margin="0,3,0,0" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                            <Border Grid.Column="1"
                                    Padding="11,0"
                                    Height="30"
                                    CornerRadius="11"
                                    Background="{DynamicResource SurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    VerticalAlignment="Center"
                                    ToolTip="Sabby Optimizer is running with administrator rights">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#31B866" VerticalAlignment="Center" />
                                    <TextBlock Text="ADMIN" Margin="5,0,0,0" FontSize="9" LineHeight="12" LineStackingStrategy="BlockLineHeight" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <ScrollViewer x:Name="MainScrollViewer"
                              Grid.Row="1"
                              RequestBringIntoView="MainScrollViewer_RequestBringIntoView"
                              CanContentScroll="False"
                              IsDeferredScrollingEnabled="True"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled"
                              Background="Transparent">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource AppVerticalScrollBarStyle}" />
                    </ScrollViewer.Resources>
                    <ContentControl x:Name="MainContentHost"
                                    Content="{Binding CurrentViewModel, Mode=OneWay}"
                                    Margin="20,16,20,22"
                                    HorizontalAlignment="Stretch"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalContentAlignment="Stretch" />
                </ScrollViewer>
            </Grid>

            <Border x:Name="ToastHost"
                    Panel.ZIndex="100"
                    Width="380"
                    Margin="0,86,20,0"
                    Padding="16,13"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="13"
                    Visibility="Collapsed"
                    Opacity="0">
                <Border.RenderTransform><TranslateTransform X="24" /></Border.RenderTransform>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="4"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border x:Name="ToastAccent" Width="4" CornerRadius="2" Background="{DynamicResource AccentBrush}" />
                    <StackPanel Grid.Column="2">
                        <TextBlock x:Name="ToastTitleText" FontSize="12" FontWeight="SemiBold" />
                        <TextBlock x:Name="ToastMessageText" Margin="0,4,0,0" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
