<UserControl x:Class="PCTweaker.Views.StartupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <!-- This is deliberately NOT a loading/splash screen. Core detection continues in the
         background while the real Sabby shell is already visible and responsive. -->
    <StackPanel HorizontalAlignment="Stretch">
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Sabby Optimizer" FontSize="28" FontWeight="SemiBold" />
                <TextBlock Text="Your Windows performance workspace" Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
            <Border Grid.Column="1" Style="{StaticResource SoftPillStyle}" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="WORKSPACE" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </Border>
        </Grid>

        <UniformGrid Columns="3" Margin="0,0,0,18">
            <Border Style="{StaticResource FeatureCardStyle}" Margin="0,0,7,0">
                <StackPanel>
                    <Border Style="{StaticResource IconTileStyle}" HorizontalAlignment="Left"><TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="Performance" Style="{StaticResource CardTitleTextStyle}" Margin="0,15,0,0" />
                    <TextBlock Text="FPS, CPU, GPU, input, Windows and hardware-aware controls." Style="{StaticResource CardBodyTextStyle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource FeatureCardStyle}" Margin="7,0">
                <StackPanel>
                    <Border Style="{StaticResource IconTileStyle}" HorizontalAlignment="Left"><TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="Latency" Style="{StaticResource CardTitleTextStyle}" Margin="0,15,0,0" />
                    <TextBlock Text="Measure gateway, public path, DNS and candidate game endpoints." Style="{StaticResource CardBodyTextStyle}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource FeatureCardStyle}" Margin="7,0,0,0">
                <StackPanel>
                    <Border Style="{StaticResource IconTileStyle}" HorizontalAlignment="Left"><TextBlock Text="&#xE777;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                    <TextBlock Text="Protected changes" Style="{StaticResource CardTitleTextStyle}" Margin="0,15,0,0" />
                    <TextBlock Text="Verification and rollback protection stay active while background discovery finishes." Style="{StaticResource CardBodyTextStyle}" />
                </StackPanel>
            </Border>
        </UniformGrid>

    </StackPanel>
</UserControl>