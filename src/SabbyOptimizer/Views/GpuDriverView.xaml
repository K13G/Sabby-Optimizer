<UserControl x:Class="PCTweaker.Views.GpuDriverView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <StackPanel>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="GPU Driver Integrations" Style="{StaticResource SectionHeadingTextStyle}"/>
                <TextBlock Text="Supported NVIDIA, AMD, and Intel integration with read-back verification. Sabby avoids undocumented profile-database hacks."
                           Margin="0,5,18,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Refresh detection" Command="{Binding RefreshCommand}" VerticalAlignment="Center"/>
        </Grid>

        <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180"/>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="1.25*"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="VENDOR" Style="{StaticResource EyebrowTextStyle}"/>
                    <TextBlock Text="{Binding Vendor}" Margin="0,7,0,0" FontSize="20" FontWeight="SemiBold"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="14,0,14,0">
                    <TextBlock Text="GPU" Style="{StaticResource EyebrowTextStyle}"/>
                    <TextBlock Text="{Binding GpuName}" Margin="0,7,0,0" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <TextBlock Text="{Binding DriverInfo}" Margin="0,5,0,0" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="SUPPORTED INTEGRATION" Style="{StaticResource EyebrowTextStyle}"/>
                    <TextBlock Text="{Binding Integration}" Margin="0,7,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Grid>
        </Border>

        <ProgressBar Height="5" Value="{Binding Progress, Mode=OneWay}"
                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                     Margin="0,0,0,12"/>

        <ItemsControl>
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="{DynamicResource CardColumns}"/>
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.Items>
                <Border Style="{StaticResource CardStyle}" Margin="5" Padding="15" MinHeight="300">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="QUALITY-SAFE PERFORMANCE" Style="{StaticResource EyebrowTextStyle}"/>
                            <TextBlock Text="Apply &amp; verify GPU profile" Margin="0,8,0,0" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Row="1" Margin="0,10,0,10">
                            <TextBlock Text="Sets saved games to Windows High performance GPU preference and verifies every read-back. On NVIDIA, Sabby also uses NVIDIA's public NVAPI Driver Settings interface for a conservative no-quality-loss global profile."
                                       Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="17"/>
                            <TextBlock Text="Image Scaling and texture-filter quality reductions stay disabled. AMD/Intel remain on supported Windows/vendor paths rather than undocumented flags."
                                       Margin="0,9,0,0" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Button Grid.Row="2" Content="Apply &amp; verify" Command="{Binding ApplyCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Stretch"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="5" Padding="15" MinHeight="300">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="DETECTED SUPPORT" Style="{StaticResource EyebrowTextStyle}"/>
                            <TextBlock Text="What Sabby can control" Margin="0,8,0,0" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1" Text="{Binding Summary}" Margin="0,10,0,10"
                                   Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="17"/>
                        <Button Grid.Row="2" Content="Open vendor app" Command="{Binding OpenVendorAppCommand}"
                                HorizontalAlignment="Stretch"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="5" Padding="15" MinHeight="300">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <StackPanel>
                            <TextBlock Text="ROLLBACK" Style="{StaticResource EyebrowTextStyle}"/>
                            <TextBlock Text="Restore previous GPU settings" Margin="0,8,0,0" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        </StackPanel>
                        <TextBlock Grid.Row="1"
                                   Text="Restores the exact Windows per-game graphics values recorded before Sabby changed them. NVIDIA public NVAPI settings changed by Sabby are restored from their saved values as well."
                                   Margin="0,10,0,10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="17"/>
                        <Button Grid.Row="2" Content="Restore previous" Command="{Binding RestoreCommand}" HorizontalAlignment="Stretch"/>
                    </Grid>
                </Border>
            </ItemsControl.Items>
        </ItemsControl>

        <Border Style="{StaticResource SubtlePanelStyle}" Margin="5,14,5,0">
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
        </Border>
    </StackPanel>
</UserControl>
