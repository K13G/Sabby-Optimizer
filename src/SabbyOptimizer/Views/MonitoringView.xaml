<UserControl x:Class="PCTweaker.Views.MonitoringView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="PHASE 20" Style="{StaticResource EyebrowTextStyle}" />
                <TextBlock Text="Monitoring &amp; Automation" Style="{StaticResource SectionHeadingTextStyle}" Margin="0,4,0,0" />
                <TextBlock Text="Live clocks, utilization, temperatures when a trustworthy sensor source exists, network activity, game profiles, and automatic behavior."
                           Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="22,0,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border Padding="9,5" CornerRadius="11" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Margin="0,0,10,0">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="#251F232A" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsMonitoringRunning}" Value="True"><Setter Property="Background" Value="#2431B866" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7" Height="7" Margin="0,0,6,0" VerticalAlignment="Center">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="#8A939F" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsMonitoringRunning}" Value="True"><Setter Property="Fill" Value="#31B866" /></DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding MonitoringStateLabel}" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                    <Button Content="Refresh now" Command="{Binding RefreshNowCommand}" />
                    <Button Content="Start" Command="{Binding StartMonitoringCommand}" Style="{StaticResource SuccessButtonStyle}" Margin="8,0,0,0" />
                    <Button Content="Stop" Command="{Binding StopMonitoringCommand}" Style="{StaticResource DangerButtonStyle}" Margin="8,0,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding MonitoringStateDetail}" HorizontalAlignment="Right" Margin="0,7,0,0" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" MaxWidth="520" TextAlignment="Right" />
            </StackPanel>
        </Grid>

        <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="LOCAL CLOCK" FontSize="10" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding ClockText}" FontSize="30" FontWeight="SemiBold" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding DateText}" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="18,0,0,0">
                    <TextBlock Text="UPTIME" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="{Binding UptimeText}" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="2" Margin="18,0,0,0">
                    <TextBlock Text="ACTIVE GAME" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="{Binding ActiveGame}" FontSize="16" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="3" Margin="18,0,0,0">
                    <TextBlock Text="ACTIVE PROFILE" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="{Binding ActiveProfile}" FontSize="14" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>

        <UniformGrid Columns="4" Margin="-5,0,-5,0">
            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="5">
                <StackPanel>
                    <TextBlock Text="CPU" FontSize="10" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CpuUsageText}" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <ProgressBar Value="{Binding CpuUsagePercent, Mode=OneWay}" Maximum="100" Height="6" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding CpuClockText}" Margin="0,10,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="5">
                <StackPanel>
                    <TextBlock Text="MEMORY" FontSize="10" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding MemoryText}" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,0" TextWrapping="Wrap" />
                    <ProgressBar Value="{Binding MemoryUsagePercent, Mode=OneWay}" Maximum="100" Height="6" Margin="0,10,0,0" />
                    <TextBlock Text="Physical RAM used / total" Margin="0,10,0,0" Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="5">
                <StackPanel>
                    <TextBlock Text="GPU" FontSize="10" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding GpuUsageText}" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,0" />
                    <ProgressBar Value="{Binding GpuUsagePercent, Mode=OneWay}" Maximum="100" Height="6" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding GpuName}" Margin="0,10,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
            <Border Style="{StaticResource CardStyle}" Padding="16" Margin="5">
                <StackPanel>
                    <TextBlock Text="GPU TEMPERATURE" FontSize="10" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding GpuTemperatureText}" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsGpuHot}" Value="True"><Setter Property="Foreground" Value="#D95B65" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                    <TextBlock Text="{Binding GpuClockText}" Margin="0,10,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding GpuPowerText}" Margin="0,5,0,0" Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
            </Border>
        </UniformGrid>

        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="0.75*"/></Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,7,0">
                <StackPanel>
                    <TextBlock Text="Automation" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="Use the game-profile system Sabby already verifies. Linked presets win; the fallback preset only applies when a detected game has no linked preset, and previous supported tweak states are restored when the game closes."
                               Margin="0,6,0,14" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />

                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,14,0">
                            <CheckBox IsChecked="{Binding MonitoringEnabled}" Content="Live monitoring on app launch" Margin="0,0,0,10" />
                            <CheckBox IsChecked="{Binding AutoGameProfilesEnabled}" Content="Automatically apply game profiles" Margin="0,0,0,10" />
                            <CheckBox IsChecked="{Binding SmartGameTuningEnabled}" Content="Add hardware-aware Smart tuning" Margin="0,0,0,10" />
                            <CheckBox IsChecked="{Binding ThermalAlertsEnabled}" Content="Show thermal warning notifications" />
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Fallback preset" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding FallbackPresets}" SelectedItem="{Binding SelectedFallbackPreset, Mode=TwoWay}" Margin="0,6,0,11" />
                            <TextBlock Text="Refresh interval" FontWeight="SemiBold" />
                            <ComboBox ItemsSource="{Binding RefreshIntervals}" SelectedItem="{Binding SelectedRefreshIntervalMs, Mode=TwoWay}" Margin="0,6,0,11">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding StringFormat={}{0} ms}" /></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Thermal warning" FontWeight="SemiBold" />
                                <TextBlock Grid.Column="1" Text="{Binding ThermalWarningCelsius, StringFormat={}{0:F0} °C}" Foreground="{DynamicResource TextSecondaryBrush}" />
                            </Grid>
                            <Slider Minimum="60" Maximum="100" Value="{Binding ThermalWarningCelsius, Mode=TwoWay}" Margin="0,7,0,0" />
                        </StackPanel>
                    </Grid>
                    <Button Content="Save automation" Command="{Binding SaveAutomationCommand}" Style="{StaticResource PrimaryButtonStyle}" HorizontalAlignment="Left" Margin="0,16,0,0" />
                    <TextBlock Text="{Binding AutomationStatus}" Margin="0,9,0,0" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1" Style="{StaticResource CardStyle}" Padding="18" Margin="7,0,0,0">
                <StackPanel>
                    <TextBlock Text="Live network" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding NetworkText}" FontSize="18" FontWeight="SemiBold" Margin="0,10,0,0" />
                    <TextBlock Text="{Binding MonitorStatus}" Margin="0,9,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    <Separator Margin="0,14" />
                    <TextBlock Text="Sensor source" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding SensorSource}" Margin="0,6,0,0" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,14,0,0">
            <StackPanel>
                <TextBlock Text="Recent automation activity" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="Game detection, preset application, restoration, and Smart tuning activity appear here." Margin="0,5,0,12" Foreground="{DynamicResource TextSecondaryBrush}" />
                <ItemsControl ItemsSource="{Binding RecentEvents}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,9">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="95"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding TimeText}" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Grid.Column="1" Text="{Binding Title}" FontWeight="SemiBold" Margin="8,0" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding Detail}" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="No automation event yet. Launch an enabled saved game to test the automatic profile lifecycle." Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RecentEvents.Count}" Value="0"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
