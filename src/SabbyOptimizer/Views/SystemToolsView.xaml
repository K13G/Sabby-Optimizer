<UserControl x:Class="PCTweaker.Views.SystemToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Services, startup &amp; cleanup" Style="{StaticResource SectionHeadingTextStyle}" />
                <TextBlock Text="Only reversible startup changes, optional-service controls, and safe temporary-file locations are exposed here."
                           Margin="0,5,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
        </Grid>

        <Border Style="{StaticResource SubtlePanelStyle}" Padding="10" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="QUICK MAINTENANCE" Style="{StaticResource EyebrowTextStyle}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Content="Analyze TEMP" Command="{Binding AnalyzeCleanupCommand}" Padding="11,7"/>
                <Button Content="Clean unlocked TEMP" Command="{Binding CleanCommand}" Padding="11,7" Margin="7,0,0,0"/>
                <Button Content="Disable SAFE ONLY" Command="{Binding DisableAllSafeCommand}" Padding="11,7" Margin="7,0,0,0"/>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}" Padding="18">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Startup apps" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Disable or re-enable startup entries without deleting their saved command. Every change is re-scanned before Sabby reports it as verified."
                                   Margin="0,6,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Text="{Binding StartupFilterSummary}" Margin="0,5,0,0" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" />
                        <TextBlock Text="{Binding SafeBulkStatus}" Margin="0,5,0,0" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top" Margin="18,0,0,0">
                        <Button Content="All" Command="{Binding ShowAllStartupCommand}" Padding="12,7" />
                        <Button Content="Enabled" Command="{Binding ShowEnabledStartupCommand}" Padding="12,7" Margin="7,0,0,0" />
                        <Button Content="Disabled" Command="{Binding ShowDisabledStartupCommand}" Padding="12,7" Margin="7,0,0,0" />
                        <Button Content="Disable all (SAFE ONLY)" Command="{Binding DisableAllSafeCommand}" Padding="12,7" Margin="10,0,0,0" Style="{StaticResource DangerButtonStyle}" />
                    </StackPanel>
                </Grid>

                <ItemsControl ItemsSource="{Binding StartupApps}" Margin="0,14,0,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8" Padding="12" CornerRadius="9" Background="{DynamicResource SurfaceHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="190" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="126" />
                                        <ColumnDefinition Width="86" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Scope}" Margin="0,4,0,0" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                        <TextBlock Text="{Binding VerificationText}" Margin="0,5,0,0" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Source}" Margin="12,0" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Column="2" Text="{Binding Command}" Margin="12,0" VerticalAlignment="Center" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Command}" />

                                    <StackPanel Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding DisableRecommendation}" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                        <Canvas Width="92" Height="7" SnapsToDevicePixels="True">
                                            <Border Canvas.Left="0" Width="{Binding DisableRedWidth}" Height="7" Background="#A92C36" CornerRadius="3.5,0,0,3.5" />
                                            <Border Canvas.Right="0" Width="{Binding DisableGreenWidth}" Height="7" Background="#31B866" CornerRadius="0,3.5,3.5,0" />
                                            <Border Canvas.Left="45.5" Width="1" Height="9" Canvas.Top="-1" Background="#C8FFFFFF" />
                                        </Canvas>
                                    </StackPanel>

                                    <Border Grid.Column="4" Width="74" Height="28" CornerRadius="8" Background="{DynamicResource AccentSubtleBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding StateText}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                                    </Border>
                                    <Button Grid.Column="5" Content="{Binding ActionText}" Command="{Binding ToggleCommand}" Margin="12,0,0,0" MinWidth="82" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,16,0,0">
            <StackPanel>
                <TextBlock Text="Optional services" FontSize="17" FontWeight="SemiBold" />
                <TextBlock Text="The meter is a recommendation, not a command: green means stopping is more defensible for performance/cleanup, while red means keep it running unless you know you do not need that feature. Sabby never includes these services in Disable all (SAFE ONLY)."
                           Margin="0,6,0,14"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" />
                <ItemsControl ItemsSource="{Binding Services}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="2" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,10,10" Padding="14" CornerRadius="9" Background="{DynamicResource SurfaceHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding ServiceName}" Margin="0,3,0,0" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                        </StackPanel>
                                        <Border Grid.Column="1" Width="76" Height="28" CornerRadius="8" Background="{DynamicResource AccentSubtleBrush}" HorizontalAlignment="Right" VerticalAlignment="Top">
                                            <TextBlock Text="{Binding Status}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" TextAlignment="Center" />
                                        </Border>
                                    </Grid>
                                    <TextBlock Grid.Row="1" Text="{Binding Description}" Margin="0,10,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" LineHeight="18" />
                                    <TextBlock Grid.Row="2" Text="{Binding VerificationText}" Margin="0,10,0,0" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                    <Grid Grid.Row="3" Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding StartMode}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                                            <TextBlock Text="{Binding DisableRecommendation}" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,4" />
                                            <Canvas Width="92" Height="7">
                                                <Border Canvas.Left="0" Width="{Binding DisableRedWidth}" Height="7" Background="#A92C36" CornerRadius="3.5,0,0,3.5" />
                                                <Border Canvas.Right="0" Width="{Binding DisableGreenWidth}" Height="7" Background="#31B866" CornerRadius="0,3.5,3.5,0" />
                                                <Border Canvas.Left="45.5" Width="1" Height="9" Canvas.Top="-1" Background="#C8FFFFFF" />
                                            </Canvas>
                                        </StackPanel>
                                        <Button Grid.Column="2" Content="{Binding ActionText}" Command="{Binding ToggleCommand}" MinWidth="72" />
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Temporary-file cleanup" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding CleanupStatus}" Margin="0,7,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="Cleans all deletable contents of user %TEMP% and Windows TEMP. Locked/in-use files are skipped; Downloads, Documents, game saves, browser profiles, and Recycle Bin contents are never touched."
                               Margin="0,6,0,0" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Button Content="Analyze" Command="{Binding AnalyzeCleanupCommand}" Margin="0,0,8,0" />
                    <Button Content="Clean temp files" Command="{Binding CleanCommand}" Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
