<UserControl x:Class="PCTweaker.Views.DebloatView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources><BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" /></UserControl.Resources>
    <StackPanel>
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Debloat" Style="{StaticResource SectionHeadingTextStyle}"/>
                <TextBlock Text="Conservative current-user Windows app removal. The meter shows how defensible removal is: green means safer/more optional; red means keep unless you know you do not need it." Margin="0,5,18,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="Scan" Command="{Binding ScanCommand}"/><Button Content="Remove SAFE ONLY" Command="{Binding RemoveSafeCommand}" Style="{StaticResource DangerButtonStyle}" Margin="8,0,0,0"/></StackPanel>
        </Grid>
        <Grid Margin="0,0,0,10"><TextBox Text="{Binding SearchText,UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource SearchBoxStyle}"/><TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" Margin="12,0,0,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" IsHitTestVisible="False"/></Grid>
        <ProgressBar Height="4" Value="{Binding Progress, Mode=OneWay}" Visibility="{Binding IsBusy,Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,0,0,9"/>
        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Status}" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="{Binding PageText}" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <Button Content="Previous" Command="{Binding PreviousPageCommand}" Padding="10,5"/>
                <Button Content="Next" Command="{Binding NextPageCommand}" Padding="10,5" Margin="6,0,0,0"/>
            </StackPanel>
        </Grid>
        <ItemsControl ItemsSource="{Binding Apps}">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="{DynamicResource CardColumns}"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate><DataTemplate>
                <Border Style="{StaticResource CardStyle}" Margin="5" Padding="14" MinHeight="330">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel>
                            <Border Padding="7,3" CornerRadius="8" HorizontalAlignment="Left">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{StaticResource SuccessSubtleBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding CanRemove}" Value="False">
                                                <Setter Property="Background" Value="{StaticResource DangerSubtleBrush}"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding ScoreLabel}" FontSize="9" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CanRemove}" Value="False">
                                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                            <TextBlock Text="{Binding Name}" Margin="0,10,0,0" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding PackageIdText}" Margin="0,4,0,0" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="What it is" Margin="0,10,0,0" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding WhatItIs}" Margin="0,3,0,0" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="If removed" Margin="0,9,0,0" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding RemovalEffect}" Margin="0,3,0,0" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Recommendation}" Margin="0,9,0,0" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                        <StackPanel Grid.Row="2" Margin="0,14,0,0">
                            <TextBlock Text="{Binding SafetyLabel}" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" Margin="0,0,0,4"/>
                            <Canvas Width="96" Height="7" HorizontalAlignment="Center">
                                <Border Canvas.Left="0" Width="{Binding SafetyRedWidth}" Height="7" Background="#A92C36" CornerRadius="3.5,0,0,3.5"/>
                                <Border Canvas.Right="0" Width="{Binding SafetyGreenWidth}" Height="7" Background="#31B866" CornerRadius="0,3.5,3.5,0"/>
                                <Border Canvas.Left="47.5" Width="1" Height="9" Canvas.Top="-1" Background="#C8FFFFFF"/>
                            </Canvas>
                            <ProgressBar Height="3" IsIndeterminate="True" Visibility="{Binding IsBusy,Converter={StaticResource BooleanToVisibilityConverter}}" Margin="0,9,0,0"/>
                            <TextBlock Text="{Binding Status}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            <Button Content="{Binding RemoveButtonText}" Command="{Binding RemoveCommand}" IsEnabled="{Binding CanRemove}" Style="{StaticResource DangerButtonStyle}" HorizontalAlignment="Stretch" Margin="0,9,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
