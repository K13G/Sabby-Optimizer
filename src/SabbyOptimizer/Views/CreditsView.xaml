<UserControl x:Class="PCTweaker.Views.CreditsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid MaxWidth="1050" HorizontalAlignment="Center" VerticalAlignment="Top">
        <StackPanel Margin="0,6,0,0">
            <TextBlock Text="Credits" Style="{StaticResource PageHeadingTextStyle}" HorizontalAlignment="Center"/>
            <TextBlock Text="The people behind Sabby Optimizer."
                       Style="{StaticResource PageDescriptionTextStyle}"
                       Margin="0,8,0,24"
                       HorizontalAlignment="Center"/>

            <Border Style="{StaticResource CardStyle}" Padding="34" CornerRadius="18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="116"/>
                        <ColumnDefinition Width="24"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <Border Width="116" Height="116" CornerRadius="58"
                            Background="{DynamicResource AccentSubtleBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <TextBlock Text="S" FontSize="44" FontWeight="Bold"
                                       Foreground="#FF2E3C"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="-27,0,0,0"/>
                            <TextBlock Text="O" FontSize="44" FontWeight="Bold"
                                       Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="30,0,0,0"/>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                        <Border HorizontalAlignment="Left" Padding="9,4" CornerRadius="9"
                                Background="{StaticResource SuccessSubtleBrush}">
                            <TextBlock Text="OWNER" Foreground="{StaticResource SuccessBrush}"
                                       FontSize="10" FontWeight="Bold"/>
                        </Border>
                        <TextBlock Text="{Binding OwnerName}" Margin="0,10,0,0"
                                   FontSize="28" FontWeight="SemiBold"/>
                        <TextBlock Text="{Binding OwnerRole}" Margin="0,4,0,0"
                                   FontSize="14" Foreground="{DynamicResource TextSecondaryBrush}"/>
                        <TextBlock Text="{Binding Description}" Margin="0,14,0,0"
                                   FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                   TextWrapping="Wrap"/>
                    </StackPanel>
                </Grid>
            </Border>

            <Border Style="{StaticResource SubtlePanelStyle}" Margin="0,14,0,0" Padding="18">
                <StackPanel>
                    <TextBlock Text="Sabby Optimizer" FontSize="14" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding BuildNote}" Margin="0,5,0,0"
                               Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</UserControl>
