<UserControl x:Class="PCTweaker.Views.GameProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel HorizontalAlignment="Stretch">
        <Border Style="{StaticResource CardStyle}" Padding="24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="GAME PROFILES" Style="{StaticResource EyebrowTextStyle}" />
                    <TextBlock Text="One configuration for every game"
                               Margin="0,7,0,0"
                               FontSize="24"
                               FontWeight="SemiBold" />
                    <TextBlock Text="Deep scan builds a reusable local game library. Sabby watches enabled saved executables, applies supported game settings when a game starts, and restores the previous supported states when it closes. Games never need to be running during scanning."
                               Margin="0,9,30,0"
                               MaxWidth="940"
                               HorizontalAlignment="Left"
                               Style="{StaticResource PageDescriptionTextStyle}" />

                    <StackPanel Orientation="Horizontal" Margin="0,18,0,0">
                        <Button Content="Deep scan for games"
                                Command="{Binding ScanGamesCommand}"
                                Style="{StaticResource SuccessButtonStyle}" />
                        <Button Content="Add manually"
                                Command="{Binding AddManualGameCommand}"
                                Margin="10,0,0,0" />
                        <Button Content="Save profiles"
                                Command="{Binding SaveProfilesCommand}"
                                Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>

                <Border Grid.Column="1"
                        Width="82"
                        Height="82"
                        CornerRadius="20"
                        Background="{DynamicResource AccentSubtleBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <TextBlock Text="&#xE7FC;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="33"
                               Foreground="{DynamicResource AccentBrush}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
            </Grid>
        </Border>

        <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0" Padding="16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border Height="42"
                        Background="{DynamicResource SurfaceHoverBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="11">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE721;"
                                   FontFamily="Segoe MDL2 Assets"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                        <TextBox Grid.Column="1"
                                 Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Padding="0"
                                 VerticalContentAlignment="Center"
                                 ToolTip="Search game name, platform, or executable" />
                        <Button Grid.Column="2"
                                Content="Clear"
                                Command="{Binding ClearSearchCommand}"
                                Margin="8,5,5,5"
                                MinWidth="72" Height="32" VerticalAlignment="Center" />
                    </Grid>
                </Border>

                <Border Grid.Column="2"
                        Padding="12,8"
                        CornerRadius="14"
                        Background="{DynamicResource AccentSubtleBrush}"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding GameCountText}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource AccentBrush}" />
                </Border>
            </Grid>
        </Border>

        <StackPanel Margin="2,12,2,12">
            <TextBlock Text="{Binding ScanStatus}"
                       Foreground="{DynamicResource TextMutedBrush}"
                       TextWrapping="Wrap" />
            <ProgressBar Value="{Binding ScanProgress, Mode=OneWay}" Margin="0,8,0,0">
                <ProgressBar.Style>
                    <Style TargetType="ProgressBar" BasedOn="{StaticResource PolishedProgressBarStyle}">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsScanProgressVisible}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ProgressBar.Style>
            </ProgressBar>
        </StackPanel>
        <Border Margin="0,0,0,12"
                Padding="12,9"
                CornerRadius="9"
                Background="{DynamicResource AccentSubtleBrush}"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" Fill="#31C46D" VerticalAlignment="Center" />
                <TextBlock Text="{Binding DetectionStatus}"
                           Margin="8,0,0,0"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding FilteredGames}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardStyle}" Margin="0,0,0,12" Padding="16">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="88" />
                                    <ColumnDefinition Width="1.2*" />
                                    <ColumnDefinition Width="1.5*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="74" Height="74" CornerRadius="15" Background="{DynamicResource SurfaceHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" HorizontalAlignment="Left" VerticalAlignment="Top" ClipToBounds="True">
                                    <Grid>
                                        <Image Source="{Binding Icon}" Width="70" Height="70" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="24" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers><DataTrigger Binding="{Binding Icon}" Value="{x:Null}"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="0,0,18,0">
                                    <TextBlock Text="GAME" Style="{StaticResource EyebrowTextStyle}" />
                                    <Button Command="{Binding ToggleSettingsCommand}" Margin="0,5,0,0" Padding="0" HorizontalAlignment="Left" Background="Transparent" BorderThickness="0" ToolTip="Open Sabby-managed settings for this game">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding SettingsChevron}" FontFamily="Segoe MDL2 Assets" Margin="8,1,0,0" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Border Padding="8,3" CornerRadius="9" Background="{DynamicResource AccentSubtleBrush}"><TextBlock Text="{Binding Platform}" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" /></Border>
                                        <CheckBox Content="Enabled" IsChecked="{Binding IsIncluded, Mode=TwoWay}" Margin="12,0,0,0" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Ellipse Width="7" Height="7" VerticalAlignment="Center">
                                            <Ellipse.Style><Style TargetType="Ellipse"><Setter Property="Fill" Value="{DynamicResource TextMutedBrush}" /><Style.Triggers><DataTrigger Binding="{Binding IsRunning}" Value="True"><Setter Property="Fill" Value="#31C46D" /></DataTrigger></Style.Triggers></Style></Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock Text="{Binding RuntimeStatus}" Margin="7,0,0,0" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Margin="0,0,18,0">
                                    <TextBlock Text="EXECUTABLE" Style="{StaticResource EyebrowTextStyle}" />
                                    <TextBlock Text="{Binding ExecutablePath}" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" ToolTip="{Binding ExecutablePath}" />
                                    <TextBlock Text="Click the game name to edit its Sabby-managed settings." Margin="0,8,0,0" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" />
                                </StackPanel>
                                <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                    <Button Content="Change exe" Command="{Binding ChangeExecutableCommand}" MinWidth="96" ToolTip="Choose the executable Sabby should watch for this game" />
                                    <Button Content="Remove" Command="{Binding RemoveCommand}" Style="{StaticResource DangerButtonStyle}" Margin="0,8,0,0" MinWidth="96" />
                                </StackPanel>
                            </Grid>

                            <Border Grid.Row="1" Margin="88,15,0,0" Padding="16" CornerRadius="11" Background="{DynamicResource SurfaceHoverBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                        <Style.Triggers><DataTrigger Binding="{Binding IsSettingsOpen}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="1*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="WINDOWS GRAPHICS PREFERENCE" Style="{StaticResource FieldLabelTextStyle}" />
                                        <ComboBox ItemsSource="{Binding GraphicsPreferenceOptions}" SelectedItem="{Binding GraphicsPreference, Mode=TwoWay}" Margin="0,7,0,0" />
                                        <TextBlock Text="Writes Windows' per-app GPU preference for this exact executable and verifies the registry read-back." Margin="0,6,0,0" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="PROCESS PRIORITY" Style="{StaticResource FieldLabelTextStyle}" />
                                        <ComboBox ItemsSource="{Binding ProcessPriorityOptions}" SelectedItem="{Binding ProcessPriority, Mode=TwoWay}" Margin="0,7,0,0" />
                                        <TextBlock Text="Applied only while Sabby detects this exact game process. Real-time priority is intentionally not exposed." Margin="0,6,0,0" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel Grid.Column="4">
                                        <TextBlock Text="PROFILE NOTE" Style="{StaticResource FieldLabelTextStyle}" />
                                        <TextBox Text="{Binding Notes, Mode=TwoWay, UpdateSourceTrigger=LostFocus}" Margin="0,7,0,0" ToolTip="Optional note saved only in Sabby Optimizer" />
                                        <Button Content="Apply" Command="{Binding ApplySettingsCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,9,0,0" HorizontalAlignment="Stretch" ToolTip="Apply and verify this game's Windows graphics preference and process priority" />
                                    </StackPanel>

                                    <Border Grid.Row="1" Grid.ColumnSpan="5" Margin="0,14,0,0" Padding="11" CornerRadius="8" Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                                        <StackPanel>
                                            <ProgressBar Height="4" IsIndeterminate="True" Margin="0,0,0,8">
                                                <ProgressBar.Style>
                                                    <Style TargetType="ProgressBar" BasedOn="{StaticResource PolishedProgressBarStyle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers><DataTrigger Binding="{Binding IsApplyingSettings}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                    </Style>
                                                </ProgressBar.Style>
                                            </ProgressBar>
                                            <TextBlock Text="{Binding GameSettingsStatus}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Style="{StaticResource CardStyle}" Margin="0,4,0,0" Padding="18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="42" Height="42" CornerRadius="11" Background="{DynamicResource AccentSubtleBrush}">
                    <TextBlock Text="&#xE946;"
                               FontFamily="Segoe MDL2 Assets"
                               Foreground="{DynamicResource AccentBrush}"
                               FontSize="18"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>
                <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Deep local discovery" FontWeight="SemiBold" />
                    <TextBlock Text="The scanner checks launcher metadata first, then searches Documents, itch.io folders, user game folders, and common install locations. Known runtimes, redistributables, idlers, VR tools, installers, updaters, services, overlays, and helpers are rejected. Scan results stay saved between app updates. Steam artwork is loaded from the local Steam cache when available; otherwise Sabby Optimizer asks Windows for the largest local executable icon."
                               Margin="0,5,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Border>
    </StackPanel>
</UserControl>
