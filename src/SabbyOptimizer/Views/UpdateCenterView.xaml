<UserControl x:Class="PCTweaker.Views.UpdateCenterView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Update everything from one place" FontSize="21" FontWeight="SemiBold" />
                    <TextBlock Margin="0,6,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               Text="Sabby checks Windows Update for Windows and driver updates, and WinGet for installed application updates. Driver installs come from Windows Update—not random driver-download sites." />
                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                        <CheckBox Content="Auto update on Sabby launch" IsChecked="{Binding AutoUpdateEnabled, Mode=TwoWay}" />
                        <CheckBox Content="Include optional Windows updates" IsChecked="{Binding IncludeOptionalWindowsUpdates, Mode=TwoWay}" Margin="24,0,0,0" />
                    </StackPanel>
                    <TextBlock Margin="0,7,0,0" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"
                               Text="Auto update never forces a restart. Driver updates are included; optional Windows software/preview updates follow the optional-updates switch." />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                    <Button Content="Check for updates" Command="{Binding CheckCommand}" MinWidth="132" />
                    <Button Content="Update all" Command="{Binding UpdateAllCommand}" Style="{StaticResource SuccessButtonStyle}" MinWidth="112" Margin="8,0,0,0" />
                    <Button Content="Cancel" Command="{Binding CancelCommand}" MinWidth="84" Margin="8,0,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource CardStyle}" Padding="16" Margin="0,0,0,14">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="{Binding Status}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding CurrentOperation}" Margin="0,5,0,0" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding CountText}" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" Margin="16,0,0,0" />
                </Grid>
                <ProgressBar Value="{Binding OverallProgress, Mode=OneWay}" IsIndeterminate="{Binding OverallIndeterminate, Mode=OneWay}" Height="7" Margin="0,12,0,0" Style="{StaticResource PolishedProgressBarStyle}" />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Style="{StaticResource SubtlePanelStyle}">
                        <StackPanel>
                            <TextBlock Text="Windows + drivers" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding WindowsStatus}" Margin="0,4,0,0" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource SubtlePanelStyle}">
                        <StackPanel>
                            <TextBlock Text="Applications" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding AppStatus}" Margin="0,4,0,0" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding Updates}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="{DynamicResource CardColumns}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardStyle}" Margin="5" Padding="15" MinHeight="190">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal">
                                    <Border Padding="7,3" CornerRadius="8" Background="{DynamicResource SurfaceHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <TextBlock Text="{Binding KindLabel}" FontSize="9" FontWeight="SemiBold" />
                                    </Border>
                                    <Border Margin="6,0,0,0" Padding="7,3" CornerRadius="8" Background="{DynamicResource AccentSubtleBrush}" Visibility="{Binding IsOptional, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <TextBlock Text="OPTIONAL" FontSize="9" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Column="1" Text="{Binding Source}" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="110" />
                            </Grid>

                            <StackPanel Grid.Row="1" Margin="0,13,0,12">
                                <TextBlock Text="{Binding Title}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding VersionText}" Margin="0,7,0,0" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel Grid.Row="2">
                                <TextBlock Text="{Binding Status}" FontSize="10.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                                <ProgressBar Value="{Binding Progress, Mode=OneWay}" IsIndeterminate="{Binding IsIndeterminate, Mode=OneWay}" Height="5" Margin="0,8,0,0" Style="{StaticResource PolishedProgressBarStyle}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
