<UserControl x:Class="PCTweaker.Views.GameConfigStudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <StackPanel>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Per-Game Config Studio" Style="{StaticResource SectionHeadingTextStyle}" />
                <TextBlock Text="Phase 18 discovers and safely edits local text configuration files for each saved game. Sabby backs up before every write and never edits binaries or save-game data."
                           Margin="0,5,20,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Content="Refresh games" Command="{Binding RefreshGamesCommand}" VerticalAlignment="Center" />
        </Grid>

        <Border Style="{StaticResource CardStyle}" Padding="17" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.3*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="GAME" Style="{StaticResource FieldLabelTextStyle}" />
                    <ComboBox ItemsSource="{Binding Games}"
                              SelectedItem="{Binding SelectedGame, Mode=TwoWay}"
                              DisplayMemberPath="Name"
                              Margin="0,7,0,0" />
                    <TextBlock Text="{Binding SelectedGameSummary}" Margin="0,6,0,0" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="2" Content="Scan configs" Command="{Binding ScanConfigsCommand}" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom" MinWidth="110" />
                <Button Grid.Column="4" Content="Add config file" Command="{Binding AddConfigFileCommand}" VerticalAlignment="Bottom" MinWidth="110" />
            </Grid>
        </Border>

        <ProgressBar Height="5"
                     Value="{Binding Progress, Mode=OneWay}"
                     Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                     Style="{StaticResource PolishedProgressBarStyle}"
                     Margin="0,0,0,8" />
        <TextBlock Text="{Binding Status}" Margin="2,0,0,13" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="10" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>

            <!-- Discovered files -->
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="14" VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Config files" FontSize="15" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="1" Text="{Binding ConfigCountText}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Grid.Row="1" Margin="0,10,0,10">
                        <TextBox Text="{Binding FileSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="30,7,28,7" ToolTip="Search discovered config files" />
                        <TextBlock Text="&#xE721;" FontFamily="Segoe MDL2 Assets" FontSize="12" Margin="10,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{DynamicResource TextMutedBrush}" />
                        <Button Content="×" Command="{Binding ClearSearchCommand}" Width="24" Height="24" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0" Background="Transparent" BorderThickness="0" />
                    </Grid>
                    <ListBox Grid.Row="2" ItemsSource="{Binding ConfigFiles}" SelectedItem="{Binding SelectedConfig, Mode=TwoWay}" MaxHeight="540" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="9" Margin="0,0,0,5" CornerRadius="7" Background="{DynamicResource SurfaceHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                            <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}" />
                                            <Border Grid.Column="1" Padding="6,2" CornerRadius="7" Background="{DynamicResource AccentSubtleBrush}" Margin="6,0,0,0">
                                                <TextBlock Text="{Binding Kind}" FontSize="8.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" />
                                            </Border>
                                        </Grid>
                                        <TextBlock Text="{Binding LocationLabel}" Margin="0,5,0,0" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" />
                                        <TextBlock Margin="0,4,0,0" FontSize="9" Foreground="{DynamicResource TextMutedBrush}">
                                            <Run Text="{Binding SizeText, Mode=OneWay}"/><Run Text=" • "/><Run Text="{Binding ModifiedText, Mode=OneWay}"/>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Text editor -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="14" VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Editor" FontSize="15" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding SelectedFilePath}" Margin="0,4,10,0" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedFilePath}" />
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding EncodingText}" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                    </Grid>

                    <WrapPanel Grid.Row="1" Margin="0,10,0,0">
                        <Button Content="Save &amp; verify" Command="{Binding SaveCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,0,7,0" />
                        <Button Content="Reload" Command="{Binding ReloadCommand}" Margin="0,0,7,0" />
                        <Button Content="Backup now" Command="{Binding BackupCommand}" Margin="0,0,7,0" />
                        <Button Content="Restore latest" Command="{Binding RestoreBackupCommand}" Margin="0,0,7,0" />
                        <Button Content="Open folder" Command="{Binding OpenFolderCommand}" />
                    </WrapPanel>

                    <Border Grid.Row="2" Margin="0,10,0,0" Padding="9" CornerRadius="7" Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                        <TextBlock Text="{Binding DocumentStatus}" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    </Border>

                    <TextBlock Grid.Row="3" Text="Sabby blocks malformed JSON/XML saves, creates a pre-save backup, writes atomically, then re-reads the file to verify the exact editor text."
                               Margin="1,8,0,8" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />

                    <TextBox Grid.Row="4"
                             Text="{Binding EditorText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             FontFamily="Consolas"
                             FontSize="12"
                             AcceptsReturn="True"
                             AcceptsTab="True"
                             TextWrapping="NoWrap"
                             VerticalScrollBarVisibility="Auto"
                             HorizontalScrollBarVisibility="Auto"
                             MinHeight="460"
                             Padding="11"
                             SpellCheck.IsEnabled="False" />
                </Grid>
            </Border>

            <!-- Quick INI/CFG keys -->
            <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="14" VerticalAlignment="Stretch">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Quick settings" FontSize="15" FontWeight="SemiBold" />
                    <TextBlock Grid.Row="1" Text="INI/CFG-style key=value settings appear here automatically. Sabby never guesses what a key means; it only stages the value you enter."
                               Margin="0,6,0,10" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                    <ListBox Grid.Row="2" ItemsSource="{Binding QuickEntries}" SelectedItem="{Binding SelectedQuickEntry, Mode=TwoWay}" MaxHeight="420">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,5">
                                    <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" FontSize="10.5" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding Value}" Margin="0,3,0,0" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel Grid.Row="3" Margin="0,10,0,0">
                        <TextBlock Text="STAGED VALUE" Style="{StaticResource FieldLabelTextStyle}" />
                        <TextBox Text="{Binding SelectedQuickEntry.Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="0,6,0,0" />
                        <Button Content="Stage key in editor" Command="{Binding ApplyQuickValueCommand}" Margin="0,8,0,0" />
                        <TextBlock Text="Nothing is written until Save &amp; verify is clicked." Margin="0,6,0,0" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
