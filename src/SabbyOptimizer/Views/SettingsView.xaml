<UserControl x:Class="PCTweaker.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    </UserControl.Resources>

    <Grid HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" HorizontalAlignment="Stretch">
            <TextBlock Text="Application settings" Style="{StaticResource PageHeadingTextStyle}" />
            <TextBlock Text="Customize how Sabby Optimizer looks and behaves. Appearance changes only affect this app."
                       Style="{StaticResource PageDescriptionTextStyle}"
                       Margin="0,8,0,24" />

            <Border Style="{StaticResource CardStyle}" HorizontalAlignment="Stretch">
                <StackPanel>
                    <TextBlock Text="Appearance" Style="{StaticResource CardTitleTextStyle}" />
                    <TextBlock Text="Theme and visual style are independent. Every style works with System, Dark, Darkness, and Light."
                               Style="{StaticResource CardBodyTextStyle}" />

                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="300" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="Theme" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,7" />
                            <ComboBox ItemsSource="{Binding AvailableThemes}"
                                      SelectedItem="{Binding SelectedTheme, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                      HorizontalAlignment="Stretch" />
                            <TextBlock Text="Darkness uses true black app backgrounds with white text and raised controls."
                                       Margin="0,7,0,0"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Visual style" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,7" />

                            <ToggleButton x:Name="VisualStyleSelectorButton"
                                          IsChecked="{Binding IsStylePickerOpen, Mode=TwoWay}"
                                          HorizontalAlignment="Stretch"
                                          Style="{StaticResource SelectorToggleButtonStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="26" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding SelectedVisualStyleOption.Name}"
                                               VerticalAlignment="Center"
                                               FontWeight="SemiBold" />
                                    <Border Grid.Column="1"
                                            Margin="12,0,0,0"
                                            Padding="7,2"
                                            CornerRadius="9"
                                            Background="{DynamicResource AccentSubtleBrush}"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="{Binding SelectedVisualStyleOption.BadgeText}"
                                                   FontSize="10"
                                                   FontWeight="SemiBold"
                                                   Foreground="{DynamicResource AccentBrush}" />
                                    </Border>
                                    <Path Grid.Column="2"
                                          Width="10"
                                          Height="6"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Stroke="{DynamicResource TextSecondaryBrush}"
                                          StrokeThickness="1.6"
                                          StrokeStartLineCap="Round"
                                          StrokeEndLineCap="Round"
                                          Data="M 1 1 L 5 5 L 9 1" />
                                </Grid>
                            </ToggleButton>

                            <Popup PlacementTarget="{Binding ElementName=VisualStyleSelectorButton}"
                                   Placement="Bottom"
                                   IsOpen="{Binding IsStylePickerOpen, Mode=TwoWay}"
                                   StaysOpen="False"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade"
                                   DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}"
                                   Width="{Binding PlacementTarget.ActualWidth, RelativeSource={RelativeSource Self}}">
                                <Border Margin="0,5,0,0"
                                        Padding="10"
                                        MaxHeight="520"
                                        Background="{DynamicResource SurfaceBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="10">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="42" />
                                            </Grid.ColumnDefinitions>

                                            <Border Grid.Column="0"
                                                    Height="40"
                                                    Background="{DynamicResource SurfaceHoverBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="7">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="34" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0"
                                                               Text="&#xE721;"
                                                               FontFamily="Segoe MDL2 Assets"
                                                               FontSize="14"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               HorizontalAlignment="Center"
                                                               VerticalAlignment="Center" />
                                                    <Grid Grid.Column="1">
                                                        <TextBox x:Name="VisualStyleSearchBox"
                                                                 Text="{Binding VisualStyleSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                 Background="Transparent"
                                                                 BorderThickness="0"
                                                                 Padding="0"
                                                                 VerticalContentAlignment="Center" />
                                                        <TextBlock Text="Search"
                                                                   IsHitTestVisible="False"
                                                                   VerticalAlignment="Center"
                                                                   Foreground="{DynamicResource TextMutedBrush}">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Text, ElementName=VisualStyleSearchBox}" Value="">
                                                                            <Setter Property="Visibility" Value="Visible" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>
                                                </Grid>
                                            </Border>

                                            <ToggleButton x:Name="StyleSortButton"
                                                          Grid.Column="2"
                                                          Width="42"
                                                          Height="40"
                                                          Padding="0"
                                                          Style="{StaticResource SelectorToggleButtonStyle}"
                                                          ToolTip="Sort visual styles">
                                                <Viewbox Width="19" Height="19">
                                                    <Canvas Width="20" Height="20">
                                                        <Path Stroke="{DynamicResource TextPrimaryBrush}"
                                                              StrokeThickness="1.7"
                                                              StrokeStartLineCap="Round"
                                                              StrokeEndLineCap="Round"
                                                              Data="M 2,4 L 11,4 M 2,9 L 9,9 M 2,14 L 7,14 M 15,3 L 15,15 M 12,12 L 15,15 L 18,12" />
                                                    </Canvas>
                                                </Viewbox>
                                            </ToggleButton>
                                        </Grid>

                                        <Border Grid.Row="1"
                                                Margin="0,8,0,0"
                                                Padding="5"
                                                Width="230"
                                                HorizontalAlignment="Right"
                                                Background="{DynamicResource SurfaceHoverBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Visibility="{Binding IsChecked, ElementName=StyleSortButton, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <ListBox ItemsSource="{Binding SortOptions}"
                                                     SelectedItem="{Binding SelectedSortOption, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource StylePickerListBoxStyle}"
                                                     MaxHeight="280">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Name}" />
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </Border>

                                        <Grid Grid.Row="2" Margin="0,10,0,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <TextBlock Text="Style type / event"
                                                           VerticalAlignment="Center"
                                                           Style="{StaticResource FieldLabelTextStyle}" />
                                                <TextBlock Text="{Binding FilteredStyleCountText}"
                                                           HorizontalAlignment="Right"
                                                           VerticalAlignment="Center"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           FontSize="11" />
                                            </Grid>
                                            <ListBox Grid.Row="1"
                                                     Margin="0,7,0,0"
                                                     ItemsSource="{Binding EventFilters}"
                                                     SelectedItem="{Binding SelectedEventFilter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                     Background="Transparent"
                                                     BorderThickness="0"
                                                     HorizontalContentAlignment="Stretch"
                                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                                                <ListBox.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal" />
                                                    </ItemsPanelTemplate>
                                                </ListBox.ItemsPanel>
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                                                        <Setter Property="Background" Value="{DynamicResource SurfaceHoverBrush}" />
                                                        <Setter Property="Padding" Value="10,6" />
                                                        <Setter Property="Margin" Value="0,0,7,0" />
                                                        <Setter Property="Cursor" Value="Hand" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <Border x:Name="EventChip"
                                                                            Background="{TemplateBinding Background}"
                                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="12"
                                                                            Padding="{TemplateBinding Padding}">
                                                                        <ContentPresenter />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="EventChip" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                        </Trigger>
                                                                        <Trigger Property="IsSelected" Value="True">
                                                                            <Setter TargetName="EventChip" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                                                            <Setter TargetName="EventChip" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                            </ListBox>
                                        </Grid>

                                        <Border Grid.Row="3"
                                                Height="1"
                                                Background="{DynamicResource BorderBrush}"
                                                Margin="0,10,0,7" />

                                        <ListBox Grid.Row="4"
                                                 ItemsSource="{Binding FilteredVisualStyles}"
                                                 SelectedItem="{Binding StylePickerSelection, Mode=TwoWay}"
                                                 MaxHeight="330"
                                                 Style="{StaticResource StylePickerListBoxStyle}">
                                            <ListBox.Resources>
                                                <Style TargetType="ScrollBar" BasedOn="{StaticResource PopupVerticalScrollBarStyle}" />
                                            </ListBox.Resources>
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                            <TextBlock Text="{Binding Description}"
                                                                       Margin="0,4,12,0"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       TextWrapping="Wrap"
                                                                       FontSize="11" />
                                                            <TextBlock Text="{Binding EventDisplay}"
                                                                       Margin="0,4,12,0"
                                                                       Foreground="{DynamicResource AccentBrush}"
                                                                       FontWeight="SemiBold"
                                                                       FontSize="10" />
                                                        </StackPanel>
                                                        <Border Grid.Column="1"
                                                                Padding="7,3"
                                                                CornerRadius="9"
                                                                Background="{DynamicResource AccentSubtleBrush}"
                                                                VerticalAlignment="Top">
                                                            <TextBlock Text="{Binding BadgeText}"
                                                                       FontSize="9"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource AccentBrush}" />
                                                        </Border>
                                                    </Grid>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </Grid>
                                </Border>
                            </Popup>
                        </StackPanel>
                    </Grid>

                    <Border Margin="0,22,0,0"
                            Padding="16"
                            CornerRadius="10"
                            Background="{DynamicResource AccentSubtleBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="360" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Live style preview"
                                           FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="{Binding SelectedVisualStyleOption.Description}"
                                           Margin="0,5,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="{Binding SelectedVisualStyleOption.EventDisplay}"
                                           Margin="0,5,0,0"
                                           Foreground="{DynamicResource AccentBrush}"
                                           FontWeight="SemiBold" />
                            </StackPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Effect intensity"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding StyleIntensityText}"
                                               HorizontalAlignment="Right"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontWeight="SemiBold" />
                                </Grid>
                                <Slider Value="{Binding StyleIntensity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Minimum="0"
                                        Maximum="100"
                                        SmallChange="1"
                                        LargeChange="10"
                                        Style="{StaticResource AccentSliderStyle}" />

                                <Grid Margin="0,16,0,4">
                                    <TextBlock Text="Animation speed"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding AnimationSpeedText}"
                                               HorizontalAlignment="Right"
                                               Foreground="{DynamicResource AccentBrush}"
                                               FontWeight="SemiBold" />
                                </Grid>
                                <Slider Value="{Binding AnimationSpeed, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                        Minimum="0"
                                        Maximum="200"
                                        SmallChange="5"
                                        LargeChange="25"
                                        Style="{StaticResource AccentSliderStyle}" />
                                <TextBlock Text="100% is normal. 0% freezes animated styles and event motion exactly where it is."
                                           Margin="0,6,0,0"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,14,0,0" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Navigation" Style="{StaticResource CardTitleTextStyle}" />
                        <TextBlock Text="Keep Sabby Optimizer where you left it between launches."
                                   Style="{StaticResource CardBodyTextStyle}" />
                        <CheckBox Content="Remember the last page I used"
                                  IsChecked="{Binding RememberLastPage, Mode=TwoWay}"
                                  Margin="0,16,0,0" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="Changes" Style="{StaticResource CardTitleTextStyle}" />
                        <TextBlock Text="Save your previewed appearance. Settings are stored in your Windows profile, outside the app folder."
                                   Style="{StaticResource CardBodyTextStyle}" />
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Save settings"
                                    Command="{Binding SaveCommand}"
                                    Style="{StaticResource SuccessButtonStyle}" />
                            <Button Content="Reset app settings"
                                    Command="{Binding ResetCommand}"
                                    Style="{StaticResource DangerButtonStyle}"
                                    Margin="10,0,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusMessage}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   Margin="0,12,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,14,0,0" HorizontalAlignment="Stretch">
            <StackPanel>
                <TextBlock Text="Application behavior" Style="{StaticResource CardTitleTextStyle}" />
                <TextBlock Text="Choose how Sabby Optimizer starts, restores its window, and behaves when you close it."
                           Style="{StaticResource CardBodyTextStyle}" />

                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <Border Style="{StaticResource SubtlePanelStyle}">
                            <StackPanel>
                                <CheckBox Content="Remember window size and maximized state"
                                          IsChecked="{Binding RememberWindowState, Mode=TwoWay}" />
                                <TextBlock Text="If you close Sabby Optimizer maximized, it opens maximized next time. Normal window size and position are remembered too."
                                           Margin="28,6,0,0"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap"
                                           FontSize="11" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SubtlePanelStyle}" Margin="0,9,0,0">
                            <StackPanel>
                                <CheckBox Content="Always start maximized"
                                          IsChecked="{Binding StartMaximized, Mode=TwoWay}" />
                                <TextBlock Text="Forces the main workspace to open maximized even if the last saved window was normal."
                                           Margin="28,6,0,0"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap"
                                           FontSize="11" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <Border Style="{StaticResource SubtlePanelStyle}">
                            <StackPanel>
                                <CheckBox Content="Launch Sabby Optimizer with Windows"
                                          IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
                                <TextBlock Text="Adds Sabby Optimizer to your current Windows user's startup list. No administrator permission is required."
                                           Margin="28,6,0,0"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap"
                                           FontSize="11" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SubtlePanelStyle}" Margin="0,9,0,0">
                            <StackPanel>
                                <CheckBox Content="Close button sends the app to the notification area"
                                          IsChecked="{Binding CloseToTray, Mode=TwoWay}" />
                                <TextBlock Text="When enabled, clicking X hides Sabby Optimizer beside the clock instead of exiting. The tray menu still has a real Exit command."
                                           Margin="28,6,0,0"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap"
                                           FontSize="11" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SubtlePanelStyle}" Margin="0,9,0,0">
                            <StackPanel>
                                <CheckBox Content="Minimize button sends the app to the notification area"
                                          IsChecked="{Binding MinimizeToTray, Mode=TwoWay}" />
                                <TextBlock Text="When enabled, minimizing hides Sabby Optimizer beside the clock. Click the tray icon to restore it."
                                           Margin="28,6,0,0"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           TextWrapping="Wrap"
                                           FontSize="11" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <Border Style="{StaticResource SubtlePanelStyle}" Margin="0,12,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <CheckBox Content="Detect linked games while Sabby Optimizer is running"
                                      IsChecked="{Binding GameDetectionEnabled, Mode=TwoWay}" />
                            <TextBlock Text="Sabby watches only executable paths saved in Game Profiles. When a linked game starts, supported settings can be applied and the previous supported settings are restored when the game closes."
                                       Margin="28,6,0,0"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       FontSize="11" />
                        </StackPanel>

                        <StackPanel Grid.Column="2">
                            <CheckBox Content="Smart game tuning (test)"
                                      IsChecked="{Binding SmartGameTuningTest, Mode=TwoWay}" />
                            <TextBlock Text="Uses detected CPU, GPU, and RAM to choose a conservative Sabby tuning plan. It only applies tweak handlers that are supported and verified on this PC; linked presets take priority."
                                       Margin="28,6,0,0"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"
                                       FontSize="11" />
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        
        <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="0,14,0,0" HorizontalAlignment="Stretch">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Card layout" Style="{StaticResource CardTitleTextStyle}" />
                    <TextBlock Text="Choose how many tweak, Fixify, GPU, Ping, and Debloat cards appear across each row. Use fewer columns for larger text and more detail, or more columns for a denser dashboard." Style="{StaticResource CardBodyTextStyle}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="Cards per row" Style="{StaticResource FieldLabelTextStyle}" Margin="0,0,0,7" />
                    <ComboBox ItemsSource="{Binding CardColumnOptions}" SelectedItem="{Binding CardColumns, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>
            </Grid>
        </Border>
<Border Grid.Row="4" Style="{StaticResource CardStyle}" Margin="0,14,0,0" HorizontalAlignment="Stretch">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Appearance behavior" Style="{StaticResource CardTitleTextStyle}" />
                        <TextBlock Text="Theme and style previews apply immediately. Effect intensity controls glow and accents; animation speed controls every animated visual, with 0% freezing motion in place."
                                   Style="{StaticResource CardBodyTextStyle}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Style browser" Style="{StaticResource CardTitleTextStyle}" />
                        <TextBlock Text="Search by name, description, animation type, or holiday. Your saved app data remains in your Windows profile even if you delete the Sabby Optimizer program folder."
                                   Style="{StaticResource CardBodyTextStyle}" />
                    </StackPanel>
                </Grid>
            </Border>

        <Border Grid.Row="5" Style="{StaticResource CardStyle}" Margin="0,14,0,0" HorizontalAlignment="Stretch">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="Sabby updates" Style="{StaticResource CardTitleTextStyle}" />
                        <TextBlock Text="Automatic Stable-channel checks are always on. When a required update is ready, Sabby asks you to install it and reopens after Setup finishes."
                                   Style="{StaticResource CardBodyTextStyle}" MaxWidth="900" HorizontalAlignment="Left" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <Button Content="Check now" Command="{Binding UpdateManager.CheckForUpdatesCommand}" MinWidth="100" Height="38" />
                        <Button Content="{Binding UpdateManager.UpdateButtonText}" Command="{Binding UpdateManager.InstallUpdateCommand}"
                                Style="{StaticResource PrimaryButtonStyle}" MinWidth="170" Height="38" Margin="10,0,0,0" />
                    </StackPanel>
                </Grid>
                <Grid Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource SubtlePanelStyle}" Margin="0,0,10,0">
                        <StackPanel><TextBlock Text="INSTALLED" Style="{StaticResource EyebrowTextStyle}" /><TextBlock Text="{Binding UpdateManager.CurrentVersion}" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0" /></StackPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource SubtlePanelStyle}" Margin="0,0,10,0">
                        <StackPanel><TextBlock Text="AVAILABLE" Style="{StaticResource EyebrowTextStyle}" /><TextBlock Text="{Binding UpdateManager.LatestVersion}" FontSize="18" FontWeight="SemiBold" Margin="0,6,0,0" /></StackPanel>
                    </Border>
                    <Border Grid.Column="2" Style="{StaticResource SubtlePanelStyle}">
                        <StackPanel><TextBlock Text="STATUS" Style="{StaticResource EyebrowTextStyle}" /><TextBlock Text="{Binding UpdateManager.UpdateStatus}" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}" /></StackPanel>
                    </Border>
                </Grid>
                <ProgressBar Value="{Binding UpdateManager.DownloadProgress, Mode=OneWay}"
                             Visibility="{Binding UpdateManager.IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                             Style="{StaticResource PolishedProgressBarStyle}" Margin="0,12,0,0" />
                <TextBlock Text="{Binding UpdateManager.ReleaseNotes}" Margin="0,10,0,0" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Grid Grid.RowSpan="6" Panel.ZIndex="100"
              Background="#A6000000"
              Visibility="{Binding IsResetConfirmationOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Border Width="470"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="#D33B49"
                    BorderThickness="1"
                    CornerRadius="14">
                <StackPanel>
                    <Border Width="44"
                            Height="44"
                            HorizontalAlignment="Left"
                            Background="#35D33B49"
                            CornerRadius="22">
                        <TextBlock Text="!"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Foreground="#FF6671"
                                   FontSize="24"
                                   FontWeight="Bold" />
                    </Border>
                    <TextBlock Text="Reset app settings?"
                               Margin="0,16,0,0"
                               FontSize="22"
                               FontWeight="SemiBold" />
                    <TextBlock Text="This resets Sabby Optimizer's theme, visual style, intensity, animation speed, window behavior, navigation preference, and other app preferences to their defaults. It does not change Windows performance settings."
                               Margin="0,9,0,0"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"
                               LineHeight="20" />
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,22,0,0">
                        <Button Content="Cancel"
                                Command="{Binding CancelResetCommand}" />
                        <Button Content="Reset settings"
                                Command="{Binding ConfirmResetCommand}"
                                Style="{StaticResource DangerButtonStyle}"
                                Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
