<UserControl x:Class="PCTweaker.Views.PcRestoreView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="PC Restore" Style="{StaticResource SectionHeadingTextStyle}" />
                <TextBlock Text="Windows System Restore points are separate from Sabby's tweak backups. Use them for broader Windows rollback protection." Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
            </StackPanel>
            <Button Grid.Column="1" Content="Open Windows System Restore" Command="{Binding OpenSystemRestoreCommand}" VerticalAlignment="Center" />
        </Grid>

        <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="12" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Create restore point" FontSize="15" FontWeight="SemiBold" />
                    <TextBox Text="{Binding NewRestorePointName, UpdateSourceTrigger=PropertyChanged}" Margin="0,10,0,0" Padding="11,8" />
                    <TextBlock Text="Sabby automatically attempts to create “before Sabby tweaks” the first time this build is used." Margin="0,8,0,0" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" />
                </StackPanel>
                <Button Grid.Column="2" Content="Create" Command="{Binding CreateCommand}" Style="{StaticResource PrimaryButtonStyle}" VerticalAlignment="Bottom" MinWidth="100" />
            </Grid>
        </Border>

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="Restore points" FontSize="15" FontWeight="SemiBold" />
            <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshCommand}" />
        </Grid>
        <TextBlock Text="{Binding Status}" Margin="0,0,0,10" Foreground="{DynamicResource TextMutedBrush}" />

        <ItemsControl ItemsSource="{Binding RestorePoints}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,0,0,9">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="160" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="{Binding Description}" FontWeight="SemiBold" />
                                <TextBlock Text="{Binding TypeText}" Margin="0,4,0,0" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding CreatedText}" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" />
                            <TextBlock Grid.Column="2" Text="{Binding SequenceNumber, StringFormat=Restore point #{0}}" VerticalAlignment="Center" HorizontalAlignment="Right" Foreground="{DynamicResource TextMutedBrush}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
