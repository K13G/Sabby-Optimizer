<UserControl x:Class="PCTweaker.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="300"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="20">
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="SYSTEM OVERVIEW" Style="{StaticResource EyebrowTextStyle}"/>
                        <TextBlock Text="Your PC at a glance" Margin="0,6,0,0" FontSize="22" FontWeight="SemiBold"/>
                        <TextBlock Text="Hardware-aware controls load without blocking the workspace." Margin="0,7,16,0" Style="{StaticResource PageDescriptionTextStyle}"/>
                        <TextBlock Text="{Binding HardwareStatus}" Margin="0,7,16,0" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Border Style="{StaticResource SoftPillStyle}"><StackPanel Orientation="Horizontal"><Ellipse Width="7" Height="7" Fill="#31C46D"/><TextBlock Text="DETECTED" Margin="7,0,0,0" FontSize="10" FontWeight="SemiBold"/></StackPanel></Border>
                            <Border Style="{StaticResource SoftPillStyle}" Margin="8,0,0,0"><TextBlock Text="HARDWARE AWARE" FontSize="10" FontWeight="SemiBold"/></Border>
                        </StackPanel>
                    </StackPanel>
                    <Border Grid.Column="1" Width="72" Height="72" CornerRadius="18" Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1">
                        <TextBlock Text="&#xE950;" FontFamily="Segoe MDL2 Assets" FontSize="30" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </Grid>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="22">
                <StackPanel>
                    <TextBlock Text="THIS DEVICE" Style="{StaticResource EyebrowTextStyle}"/>
                    <TextBlock Text="{Binding Hardware.DeviceName}" Margin="0,7,0,0" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
                    <Border Margin="0,13,0,0" Style="{StaticResource SubtlePanelStyle}"><StackPanel>
                        <TextBlock Text="Windows" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding Hardware.Windows}" Margin="0,5,0,0" FontWeight="SemiBold" TextWrapping="Wrap"/>
                        <TextBlock Text="{Binding Hardware.WindowsDetails}" Margin="0,4,0,0" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                    </StackPanel></Border>
                </StackPanel>
            </Border>
        </Grid>

        <Grid Margin="0,20,0,10"><TextBlock Text="Hardware" Style="{StaticResource SectionHeadingTextStyle}"/><TextBlock Text="Live graphs stay inside the matching hardware cards" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="11"/></Grid>

        <UniformGrid Columns="4" Margin="-4">
            <Border Style="{StaticResource MetricCardStyle}" Margin="4"><StackPanel>
                <DockPanel><TextBlock Text="PROCESSOR" Style="{StaticResource SpecLabelTextStyle}"/><TextBlock Text="{Binding CpuPercent,StringFormat={}{0:0}%}" DockPanel.Dock="Right" Foreground="{DynamicResource AccentBrush}" FontSize="16" FontWeight="SemiBold"/></DockPanel>
                <TextBlock Text="{Binding Hardware.Processor}" Style="{StaticResource SpecValueTextStyle}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding CpuText}" Margin="0,4,0,0" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                <ItemsControl ItemsSource="{Binding CpuBars}" Height="34" Margin="0,9,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate><ItemsControl.ItemTemplate><DataTemplate><Border Height="{Binding}" VerticalAlignment="Bottom" Margin="1,0" Background="{DynamicResource AccentBrush}" CornerRadius="2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel></Border>
            <Border Style="{StaticResource MetricCardStyle}" Margin="4"><StackPanel>
                <DockPanel><TextBlock Text="GRAPHICS" Style="{StaticResource SpecLabelTextStyle}"/><TextBlock Text="{Binding GpuPercent,StringFormat={}{0:0}%}" DockPanel.Dock="Right" Foreground="{DynamicResource AccentBrush}" FontSize="16" FontWeight="SemiBold"/></DockPanel>
                <TextBlock Text="{Binding Hardware.Graphics}" Style="{StaticResource SpecValueTextStyle}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding GpuText}" Margin="0,4,0,0" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                <ItemsControl ItemsSource="{Binding GpuBars}" Height="34" Margin="0,9,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate><ItemsControl.ItemTemplate><DataTemplate><Border Height="{Binding}" VerticalAlignment="Bottom" Margin="1,0" Background="{DynamicResource AccentGradientBrush}" CornerRadius="2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel></Border>
            <Border Style="{StaticResource MetricCardStyle}" Margin="4"><StackPanel>
                <DockPanel><TextBlock Text="MEMORY" Style="{StaticResource SpecLabelTextStyle}"/><TextBlock Text="{Binding MemoryPercent,StringFormat={}{0:0}%}" DockPanel.Dock="Right" Foreground="{DynamicResource AccentBrush}" FontSize="16" FontWeight="SemiBold"/></DockPanel>
                <TextBlock Text="{Binding Hardware.Memory}" Style="{StaticResource SpecValueTextStyle}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding MemoryText}" Margin="0,4,0,0" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                <ItemsControl ItemsSource="{Binding MemoryBars}" Height="34" Margin="0,9,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate><ItemsControl.ItemTemplate><DataTemplate><Border Height="{Binding}" VerticalAlignment="Bottom" Margin="1,0" Background="{DynamicResource AccentGradientBrush}" CornerRadius="2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel></Border>
            <Border Style="{StaticResource MetricCardStyle}" Margin="4"><StackPanel>
                <DockPanel><TextBlock Text="NETWORK" Style="{StaticResource SpecLabelTextStyle}"/><TextBlock Text="{Binding NetworkReadiness,StringFormat={}{0:0}%}" DockPanel.Dock="Right" Foreground="{DynamicResource AccentBrush}" FontSize="16" FontWeight="SemiBold"/></DockPanel>
                <TextBlock Text="{Binding Hardware.Network}" Style="{StaticResource SpecValueTextStyle}" TextWrapping="Wrap"/>
                <TextBlock Text="{Binding NetworkText}" Margin="0,4,0,0" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                <ItemsControl ItemsSource="{Binding NetworkBars}" Height="34" Margin="0,9,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate><ItemsControl.ItemTemplate><DataTemplate><Border Height="{Binding}" VerticalAlignment="Bottom" Margin="1,0" Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" CornerRadius="2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel></Border>
            <Border Style="{StaticResource MetricCardStyle}" Margin="4"><StackPanel><TextBlock Text="MOTHERBOARD" Style="{StaticResource SpecLabelTextStyle}"/><TextBlock Text="{Binding Hardware.Motherboard}" Style="{StaticResource SpecValueTextStyle}" TextWrapping="Wrap"/><TextBlock Text="{Binding Hardware.MotherboardDetails}" Margin="0,5,0,0" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/></StackPanel></Border>
            <Border Style="{StaticResource MetricCardStyle}" Margin="4"><StackPanel><TextBlock Text="SYSTEM DRIVE" Style="{StaticResource SpecLabelTextStyle}"/><TextBlock Text="{Binding Hardware.SystemDrive}" Style="{StaticResource SpecValueTextStyle}" TextWrapping="Wrap"/><TextBlock Text="{Binding StorageText}" Margin="0,5,0,0" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}"/><ProgressBar Value="{Binding StoragePercent}" Style="{StaticResource PolishedProgressBarStyle}" Margin="0,8,0,0"/></StackPanel></Border>
            <Border Style="{StaticResource MetricCardStyle}" Margin="4"><StackPanel><TextBlock Text="WINDOWS" Style="{StaticResource SpecLabelTextStyle}"/><TextBlock Text="{Binding Hardware.Windows}" Style="{StaticResource SpecValueTextStyle}" TextWrapping="Wrap"/><TextBlock Text="{Binding Hardware.WindowsDetails}" Margin="0,5,0,0" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/></StackPanel></Border>
            <Border Style="{StaticResource MetricCardStyle}" Margin="4"><StackPanel><TextBlock Text="SUPPORTED FEATURES" Style="{StaticResource SpecLabelTextStyle}"/><TextBlock Text="{Binding Hardware.SupportedFeatures}" Style="{StaticResource SpecValueTextStyle}" TextWrapping="Wrap"/></StackPanel></Border>
        </UniformGrid>

        <Grid Margin="0,16,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource SubtlePanelStyle}" Padding="12"><StackPanel><DockPanel><TextBlock Text="Performance readiness" FontWeight="SemiBold"/><TextBlock Text="{Binding PerformanceReadiness,StringFormat={}{0:0}%}" DockPanel.Dock="Right" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/></DockPanel><ProgressBar Value="{Binding PerformanceReadiness}" Style="{StaticResource PolishedProgressBarStyle}" Margin="0,8,0,0"/></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource SubtlePanelStyle}" Padding="12"><StackPanel><DockPanel><TextBlock Text="Network readiness" FontWeight="SemiBold"/><TextBlock Text="{Binding NetworkReadiness,StringFormat={}{0:0}%}" DockPanel.Dock="Right" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/></DockPanel><ProgressBar Value="{Binding NetworkReadiness}" Style="{StaticResource PolishedProgressBarStyle}" Margin="0,8,0,0"/></StackPanel></Border>
            <Border Grid.Column="4" Style="{StaticResource SubtlePanelStyle}" Padding="12"><StackPanel><DockPanel><TextBlock Text="Privacy coverage" FontWeight="SemiBold"/><TextBlock Text="{Binding PrivacyReadiness,StringFormat={}{0:0}%}" DockPanel.Dock="Right" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/></DockPanel><ProgressBar Value="{Binding PrivacyReadiness}" Style="{StaticResource PolishedProgressBarStyle}" Margin="0,8,0,0"/></StackPanel></Border>
        </Grid>

        <Border Style="{StaticResource CardStyle}" Padding="14" Margin="0,12,0,0"><StackPanel><DockPanel><TextBlock Text="NETWORK ACTIVITY" Style="{StaticResource EyebrowTextStyle}"/><TextBlock Text="{Binding NetworkText}" DockPanel.Dock="Right" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/></DockPanel><ItemsControl ItemsSource="{Binding NetworkBars}" Height="46" Margin="0,8,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate><ItemsControl.ItemTemplate><DataTemplate><Border Height="{Binding}" VerticalAlignment="Bottom" Margin="1,0" Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" CornerRadius="2"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>

        <Grid Margin="0,12,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource SubtlePanelStyle}" Padding="12"><StackPanel><DockPanel><TextBlock Text="System readiness" FontWeight="SemiBold"/><TextBlock Text="{Binding SystemReadiness,StringFormat={}{0:0}%}" DockPanel.Dock="Right" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/></DockPanel><ProgressBar Value="{Binding SystemReadiness}" Style="{StaticResource PolishedProgressBarStyle}" Margin="0,8,0,0"/></StackPanel></Border>
            <Border Grid.Column="2" Style="{StaticResource SubtlePanelStyle}" Padding="12"><StackPanel><DockPanel><TextBlock Text="Storage used" FontWeight="SemiBold"/><TextBlock Text="{Binding StoragePercent,StringFormat={}{0:0}%}" DockPanel.Dock="Right" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/></DockPanel><TextBlock Text="{Binding StorageText}" Margin="0,4,0,0" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}"/><ProgressBar Value="{Binding StoragePercent}" Style="{StaticResource PolishedProgressBarStyle}" Margin="0,6,0,0"/></StackPanel></Border>
            <Border Grid.Column="4" Style="{StaticResource SubtlePanelStyle}" Padding="12"><StackPanel><DockPanel><TextBlock Text="CPU load" FontWeight="SemiBold"/><TextBlock Text="{Binding CpuPercent,StringFormat={}{0:0}%}" DockPanel.Dock="Right" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/></DockPanel><ProgressBar Value="{Binding CpuPercent}" Style="{StaticResource PolishedProgressBarStyle}" Margin="0,8,0,0"/></StackPanel></Border>
            <Border Grid.Column="6" Style="{StaticResource SubtlePanelStyle}" Padding="12"><StackPanel><DockPanel><TextBlock Text="Memory load" FontWeight="SemiBold"/><TextBlock Text="{Binding MemoryPercent,StringFormat={}{0:0}%}" DockPanel.Dock="Right" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold"/></DockPanel><ProgressBar Value="{Binding MemoryPercent}" Style="{StaticResource PolishedProgressBarStyle}" Margin="0,8,0,0"/></StackPanel></Border>
        </Grid>
    </StackPanel>
</UserControl>