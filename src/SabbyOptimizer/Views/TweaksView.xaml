<UserControl x:Class="PCTweaker.Views.TweaksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <Style x:Key="TweakCardMotionStyle" TargetType="Border">
            <!-- Keep dense tweak grids compositor-stable: no per-card hover storyboards. -->
            <Setter Property="RenderTransform" Value="{x:Null}" />
        </Style>
        <Style x:Key="TweakCategoryListStyle" TargetType="ListBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
            <Setter Property="ItemsPanel">
                <Setter.Value>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                        <Setter Property="Margin" Value="0,0,7,0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Border x:Name="Root" Padding="12,8" CornerRadius="9" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <ContentPresenter />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Root" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                            <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel HorizontalAlignment="Stretch">
        <Grid Margin="0,0,0,14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="Performance, FPS, latency &amp; system controls" Style="{StaticResource SectionHeadingTextStyle}" />
                <TextBlock Text="{Binding RefreshStatus}" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" />
            </StackPanel>

            <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Apply best for this PC" Command="{Binding ApplyBestForPcCommand}" Height="40" MinWidth="136" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" Style="{StaticResource PrimaryButtonStyle}" />
                    <Button Content="Refresh all" Command="{Binding RefreshAllCommand}" Height="40" MinWidth="100" Margin="8,0,0,0" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                </StackPanel>
                <Border Margin="0,8,0,0" Padding="10,0" Height="40" CornerRadius="9" Background="{DynamicResource SurfaceHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" Foreground="{DynamicResource AccentBrush}" FontSize="12" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="Safety &amp; Privacy" FontSize="10.5" FontWeight="SemiBold" Margin="0,1,0,0" VerticalAlignment="Center" />
                            <TextBlock FontSize="9.5" Margin="0,1,0,0" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center">
                                <Run Text="{Binding PrivacyControlCountText, Mode=OneWay}"/><Run Text="  •  "/><Run Text="{Binding NetworkControlCountText, Mode=OneWay}"/>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>

            <ScrollViewer Grid.Row="1" Grid.ColumnSpan="2" Margin="0,13,0,0" Padding="1,2,1,3" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                <ListBox ItemsSource="{Binding Categories}"
                         SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                         Style="{StaticResource TweakCategoryListStyle}" />
            </ScrollViewer>

            <Grid Grid.Row="2" Grid.ColumnSpan="2" Margin="0,12,0,0">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="10" />
                        <ColumnDefinition Width="168" />
                    </Grid.ColumnDefinitions>
                    <Grid>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource SearchBoxStyle}"
                                 ToolTip="Search tweaks by name, category, description, detected state, or verification path" />
                        <TextBlock Text="&#xE721;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="13"
                                   Margin="12,0,0,0"
                                   HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False"
                                   Foreground="{DynamicResource TextMutedBrush}" />
                    </Grid>
                    <Grid Grid.Column="2">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Sort" Margin="0,0,8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" />
                        <ComboBox Grid.Column="1" Height="38" ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSort, Mode=TwoWay}" />
                    </Grid>
                </Grid>
                <StackPanel Grid.Row="1" Margin="0,7,0,0">
                    <TextBlock Text="{Binding ApplyBestStatus}" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                    <ProgressBar Value="{Binding ApplyBestProgress, Mode=OneWay}" Margin="0,7,0,0">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar" BasedOn="{StaticResource PolishedProgressBarStyle}">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsApplyingBest}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                </StackPanel>
            </Grid>
        </Grid>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource SubtlePanelStyle}" Padding="13,10">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding ActiveCountText}" FontWeight="SemiBold" />
                    <TextBlock Text="  •  " Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="{Binding ReadyCountText}" Foreground="{DynamicResource TextSecondaryBrush}" />
                    <TextBlock Text="  •  " Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="{Binding ProtectedCountText}" Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="  •  " Foreground="{DynamicResource TextMutedBrush}" />
                    <TextBlock Text="{Binding FpsControlCountText}" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                </StackPanel>
            </Border>
            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <CheckBox Content="Actionable only" IsChecked="{Binding ShowOnlyActionable, Mode=TwoWay}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <Button Content="Competitive FPS" Command="{Binding ApplyCompetitiveFpsCommand}" ToolTip="Apply supported reversible FPS/frame-time controls and verify each change." />
                <Button Content="Max FPS (advanced)" Command="{Binding ApplyMaximumFpsCommand}" Margin="8,0,0,0" ToolTip="Also applies advanced AC processor policies such as core-unparking and a 100% performance floor. Higher power/heat; not guaranteed to improve every game." />
                <Button Content="Low-latency local stack" Command="{Binding ApplyLowLatencyProfileCommand}" Margin="8,0,0,0" ToolTip="Apply conservative local NIC/TCP controls. This does not use a proxy or tunnel." />
            </StackPanel>
        </Grid>

        <Border Margin="0,0,0,14" Padding="15,13" CornerRadius="11" Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Visibility" Value="Collapsed" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding SelectedCategory}" Value="FPS"><Setter Property="Visibility" Value="Visible" /></DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="10" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <TextBlock Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="17" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0,18,0" VerticalAlignment="Center">
                    <TextBlock Text="FPS LAB" Style="{StaticResource EyebrowTextStyle}" />
                    <TextBlock Text="Gaming capture, Game Mode, HAGS, CPU boost/EPP/ramp policy, core parking, power plan, PCIe, USB and input controls" Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="The advanced controls favor responsiveness and can increase heat/power. Sabby keeps exact rollback values and does not claim every setting raises average FPS." Margin="0,4,0,0" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <Button Grid.Column="2" Content="Refresh FPS states" Command="{Binding RefreshAllCommand}" VerticalAlignment="Center" />
            </Grid>
        </Border>

        <ItemsControl ItemsSource="{Binding VisibleTweaks}" Margin="-5">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <UniformGrid Columns="{DynamicResource CardColumns}" />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource TweakCardMotionStyle}"
                            Margin="5"
                            MinHeight="218"
                            Padding="14"
                            CornerRadius="11"
                            Background="{DynamicResource SurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                                    <Border Height="26" Padding="8,0" Margin="0,0,6,0" CornerRadius="7" Background="{DynamicResource SurfaceHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <TextBlock Text="{Binding CategoryLabel}" FontSize="8.5" Margin="0,1,0,0" TextAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    </Border>
                                    <Border Height="26" Padding="8,0" CornerRadius="7">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource WarningSubtleBrush}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource WarningBrush}"/>
                                                <Setter Property="BorderThickness" Value="1"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding SafetyLabel}" Value="SAFE">
                                                        <Setter Property="Background" Value="{StaticResource SuccessSubtleBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding SafetyLabel}" Value="ADVANCED">
                                                        <Setter Property="Background" Value="{StaticResource DangerSubtleBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{StaticResource DangerBrush}"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding SafetyLabel}" FontSize="8.5" Margin="0,1,0,0" TextAlignment="Center" FontWeight="SemiBold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="{StaticResource WarningBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SafetyLabel}" Value="SAFE"><Setter Property="Foreground" Value="{StaticResource SuccessBrush}"/></DataTrigger>
                                                        <DataTrigger Binding="{Binding SafetyLabel}" Value="ADVANCED"><Setter Property="Foreground" Value="{StaticResource DangerBrush}"/></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </StackPanel>
                                <Button Grid.Column="1" Width="29" Height="29" Padding="0" Command="{Binding ToggleExplanationCommand}" ToolTip="Details and verification" Focusable="False">
                                    <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                                </Button>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,12,0,10">
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Grid.Row="1" Text="{Binding Description}" Margin="0,6,0,0" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10.5" TextWrapping="Wrap" LineHeight="16" MaxHeight="50" />
                                <Grid Grid.Row="2" Margin="0,9,0,0">
                                    <Border x:Name="StatusPanel" Padding="9,7" CornerRadius="7" Background="{DynamicResource SurfaceHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Visible" />
                                                <Style.Triggers><DataTrigger Binding="{Binding IsExplanationOpen}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding StateDisplay}" FontSize="10.5" FontWeight="SemiBold" />
                                                <TextBlock Text="  •  " Foreground="{DynamicResource TextMutedBrush}" />
                                                <TextBlock Text="{Binding OperationMessage}" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding StateDetail}" Margin="0,4,0,0" FontSize="9.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" MaxHeight="31" />
                                        </StackPanel>
                                    </Border>
                                    <Border x:Name="InfoPanel" Padding="9,7" CornerRadius="7" Background="{DynamicResource SurfaceHoverBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" Visibility="{Binding IsExplanationOpen, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Explanation.Explanation}" FontSize="9.5" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" MaxHeight="47" />
                                            <TextBlock Text="{Binding VerificationGuide}" Margin="0,4,0,0" FontSize="9" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" MaxHeight="44" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Grid>

                            <Grid Grid.Row="2" Margin="0,3,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <Button Width="31" Height="31" Padding="0" Focusable="False" Command="{Binding RefreshCommand}" ToolTip="Refresh this control">
                                    <TextBlock Text="&#xE72C;" FontFamily="Segoe MDL2 Assets" FontSize="12" />
                                </Button>
                                <StackPanel Grid.Column="1" Margin="10,0" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding EvidenceLabel}" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center" />
                                    <Grid Width="112" Height="5" Margin="0,3,0,0" HorizontalAlignment="Center">
                                        <Border Background="#A92C36" CornerRadius="3" />
                                        <Border Width="{Binding EvidenceGreenWidth}" MaxWidth="112" HorizontalAlignment="Left" Background="#31B866" CornerRadius="3" />
                                    </Grid>
                                </StackPanel>
                                <Button Grid.Column="2" Command="{Binding ToggleActivationCommand}" Padding="0" Background="Transparent" BorderThickness="0" Focusable="False" ToolTip="{Binding ToggleHint}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding ToggleActionText}" Margin="0,0,7,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="10" />
                                                <Border x:Name="SwitchTrack" Width="36" Height="20" CornerRadius="10" Background="{DynamicResource SurfaceHoverBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                    <Ellipse x:Name="SwitchThumb" Width="14" Height="14" Margin="3,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{DynamicResource TextSecondaryBrush}">
                                                        <Ellipse.RenderTransform><TranslateTransform X="0" /></Ellipse.RenderTransform>
                                                    </Ellipse>
                                                </Border>
                                            </StackPanel>
                                            <ControlTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsActivated}" Value="True">
                                                    <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource SuccessBrush}" />
                                                    <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="{StaticResource SuccessBrush}" />
                                                    <Setter TargetName="SwitchThumb" Property="Fill" Value="White" />
                                                    <DataTrigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="SwitchThumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="16" Duration="0:0:0.11" /></Storyboard></BeginStoryboard></DataTrigger.EnterActions>
                                                    <DataTrigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="SwitchThumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.11" /></Storyboard></BeginStoryboard></DataTrigger.ExitActions>
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding IsProtectedActive}" Value="True">
                                                    <Setter TargetName="SwitchTrack" Property="Background" Value="#9A6B20" />
                                                    <Setter TargetName="SwitchTrack" Property="BorderBrush" Value="#D69B35" />
                                                    <Setter TargetName="SwitchThumb" Property="Fill" Value="White" />
                                                </DataTrigger>
                                                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Opacity" Value="0.92" /></Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Border Style="{StaticResource CardStyle}" Margin="0,16,0,0" Padding="16">
            <TextBlock Text="Sabby only exposes performance, network, privacy, and security changes with a concrete Windows mechanism and an explicit undo path. Safety &amp; Privacy controls are never included in Apply Best, and situational network options are not presented as guaranteed FPS or ping improvements."
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" />
        </Border>
    </StackPanel>
</UserControl>
