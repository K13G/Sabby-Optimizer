<UserControl x:Class="PCTweaker.Views.BenchmarkView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel>
                    <TextBlock Text="BENCHMARK LAB" Style="{StaticResource EyebrowTextStyle}"/>
                    <TextBlock Text="Benchmarking &amp; Before/After Validation" Style="{StaticResource SectionHeadingTextStyle}" Margin="0,4,0,0"/>
                </StackPanel>
                <TextBlock Text="Measure the same PC before and after tuning so Sabby can separate measurable changes from normal run-to-run noise."
                           Margin="0,5,20,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <Button Grid.Column="1" Content="Open results folder" Command="{Binding OpenFolderCommand}" VerticalAlignment="Center"/>
        </Grid>

        <Border Style="{StaticResource CardStyle}" Padding="18" Margin="0,0,0,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="VALIDATION WORKFLOW" Style="{StaticResource EyebrowTextStyle}"/>
                    <TextBlock Text="1. Run BEFORE  →  2. Apply/undo tweaks  →  3. Run AFTER" Margin="0,7,0,0" FontSize="17" FontWeight="SemiBold"/>
                    <TextBlock Text="Sabby measures CPU throughput, memory copy speed, scheduler delay, storage throughput, gateway latency/jitter/loss, and public Internet latency. Run both tests under similar background load for the fairest comparison."
                               Margin="0,7,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Button Content="Run BEFORE" Command="{Binding RunBeforeCommand}" Style="{StaticResource PrimaryButtonStyle}" MinWidth="112"/>
                    <Button Content="Run AFTER" Command="{Binding RunAfterCommand}" Margin="8,0,0,0" MinWidth="112"/>
                    <Button Content="Clear" Command="{Binding ClearCommand}" Margin="8,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Style="{StaticResource SubtlePanelStyle}" Margin="0,0,0,14">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Progress, StringFormat={}{0:F0}%}" Margin="14,0,0,0" Foreground="{DynamicResource TextMutedBrush}"/>
                </Grid>
                <ProgressBar Height="5" Value="{Binding Progress, Mode=OneWay}" Margin="0,9,0,0"/>
            </StackPanel>
        </Border>

        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/><ColumnDefinition Width="10"/><ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Style="{StaticResource CardStyle}" Padding="15">
                <StackPanel>
                    <TextBlock Text="BEFORE" Style="{StaticResource EyebrowTextStyle}"/>
                    <TextBlock Text="{Binding BeforeSummary}" Margin="0,7,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="15">
                <StackPanel>
                    <TextBlock Text="AFTER" Style="{StaticResource EyebrowTextStyle}"/>
                    <TextBlock Text="{Binding AfterSummary}" Margin="0,7,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Style="{StaticResource CardStyle}" Padding="15">
                <StackPanel>
                    <TextBlock Text="VERDICT" Style="{StaticResource EyebrowTextStyle}"/>
                    <TextBlock Text="{Binding OverallVerdict}" Margin="0,7,0,0" FontWeight="SemiBold" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Style="{StaticResource SubtlePanelStyle}" Padding="10" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="VALIDATION TOOLSET" Style="{StaticResource EyebrowTextStyle}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <TextBlock Text="CPU • memory • storage • gateway • Internet • scheduler noise bands" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <TextBlock Text="Metric-by-metric comparison" FontSize="16" FontWeight="SemiBold" Margin="0,2,0,10"/>
        <Border Style="{StaticResource CardStyle}" Padding="0">
            <StackPanel>
                <Grid Background="{DynamicResource SurfaceHoverBrush}" Margin="0" Height="36">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.15*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Metric" Margin="12,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Grid.Column="1" Text="Category" Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Grid.Column="2" Text="Before" Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Grid.Column="3" Text="After" Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Grid.Column="4" Text="Benefit" Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Grid.Column="5" Text="Result" Margin="8,0" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                </Grid>
                <ItemsControl ItemsSource="{Binding Comparisons}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="46" Margin="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="2*"/><ColumnDefinition Width="0.9*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1*"/><ColumnDefinition Width="1.15*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Name}" Margin="12,7" VerticalAlignment="Center" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="1" Text="{Binding Category}" Margin="8,7" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Grid.Column="2" Text="{Binding Before}" Margin="8,7" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="3" Text="{Binding After}" Margin="8,7" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="4" Text="{Binding Change}" Margin="8,7" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <TextBlock Grid.Column="5" Text="{Binding Verdict}" Margin="8,7" VerticalAlignment="Center" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Improved}" Value="True"><Setter Property="Foreground" Value="#31B866"/></DataTrigger>
                                                <DataTrigger Binding="{Binding Regressed}" Value="True"><Setter Property="Foreground" Value="#D95B65"/></DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <TextBlock Text="Benchmark results are evidence, not a guarantee. Internet metrics can change because of ISP routing, congestion, Wi-Fi conditions, and server location; CPU/storage results also vary with temperature and background activity. Sabby only calls a metric improved/regressed when the change clears that metric's noise band."
                   Margin="0,12,0,0" FontSize="10.5" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
    </StackPanel>
</UserControl>
