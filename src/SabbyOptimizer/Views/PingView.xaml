<UserControl x:Class="PCTweaker.Views.PingView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

        <Style x:Key="PingMetricCard" TargetType="Border" BasedOn="{StaticResource CardStyle}">
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="MinHeight" Value="104"/>
            <Setter Property="CornerRadius" Value="12"/>
        </Style>

        <Style x:Key="PingMetricValue" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="24"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,7,0,0"/>
            <Setter Property="TextOptions.TextFormattingMode" Value="Display"/>
        </Style>

        <Style x:Key="PingPill" TargetType="Border">
            <Setter Property="Padding" Value="9,4"/>
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Background" Value="{StaticResource SuccessSubtleBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource SuccessBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>

        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12">
                            <StackPanel>
                                <ToggleButton IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                              Background="Transparent" BorderThickness="0" Padding="16,12" HorizontalContentAlignment="Stretch">
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <ContentPresenter Content="{TemplateBinding Header}" VerticalAlignment="Center"/>
                                        <Path Grid.Column="1" Width="10" Height="6" Stroke="{DynamicResource TextMutedBrush}" StrokeThickness="1.5"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round" Data="M 1 1 L 5 5 L 9 1"/>
                                    </Grid>
                                </ToggleButton>
                                <ContentPresenter x:Name="ExpandSite" Visibility="Collapsed" Margin="16,0,16,16"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True"><Setter TargetName="ExpandSite" Property="Visibility" Value="Visible"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <StackPanel>
        <!-- Header -->
        <Grid Margin="0,0,0,14">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Network Lab" Style="{StaticResource SectionHeadingTextStyle}"/>
                    <Border Style="{StaticResource PingPill}" Margin="10,0,0,0">
                        <TextBlock Text="REAL MEASUREMENTS" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource SuccessBrush}"/>
                    </Border>
                </StackPanel>
                <TextBlock Text="Measure the real connection first, then make only reversible local changes that Windows can verify."
                           Margin="0,5,16,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button Content="Quick test" Command="{Binding RunTestsCommand}" Padding="16,10"/>
                <Button Content="Optimize local path" Command="{Binding ApplyBestCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="18,10" Margin="10,0,0,0"/>
            </StackPanel>
        </Grid>

        <Border Style="{StaticResource SubtlePanelStyle}" Padding="10" Margin="0,0,0,12">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="QUICK NETWORK TOOLS" Style="{StaticResource EyebrowTextStyle}" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <Button Content="Find best endpoint" Command="{Binding FindBestEndpointCommand}" Padding="11,7"/>
                <Button Content="Trace route" Command="{Binding TraceRouteCommand}" Padding="11,7" Margin="7,0,0,0"/>
                <Button Content="Flush DNS" Command="{Binding FlushDnsCommand}" Padding="11,7" Margin="7,0,0,0"/>
                <Button Content="Undo last optimization" Command="{Binding UndoLastOptimizationCommand}" Padding="11,7" Margin="7,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Non-blocking task feedback. This never covers or replaces the page. -->
        <Border Visibility="{Binding IsBusy, Converter={StaticResource BooleanToVisibilityConverter}}"
                Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1"
                CornerRadius="12" Padding="14" Margin="0,0,0,14">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="{Binding BusyTitle}" FontWeight="SemiBold"/>
                    <TextBlock Text="{Binding BusyDetail}" Margin="0,3,20,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="Working in background" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                <ProgressBar Grid.Row="1" Grid.ColumnSpan="2" Style="{StaticResource PolishedProgressBarStyle}" Value="{Binding Progress, Mode=OneWay}" Margin="0,10,0,0"/>
            </Grid>
        </Border>

        <!-- Real connection health -->
        <Border Style="{StaticResource CardStyle}" Padding="20" CornerRadius="14">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="CONNECTION HEALTH" Style="{StaticResource EyebrowTextStyle}"/>
                        <TextBlock Text="Your measured Internet path" Margin="0,5,0,0" FontSize="20" FontWeight="SemiBold"/>
                        <TextBlock Text="Ping/Jitter/Loss use live ICMP samples to a public Internet reference. Local-hop latency is measured separately."
                                   Margin="0,5,20,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                        <TextBlock Text="{Binding HealthStatus}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right"/>
                        <TextBlock Text="{Binding LastTestText}" Margin="0,4,0,0" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                    </StackPanel>
                </Grid>

                <UniformGrid Columns="4" Margin="-4,12,-4,0">
                    <Border Style="{StaticResource PingMetricCard}">
                        <StackPanel><TextBlock Text="INTERNET PING" Style="{StaticResource SpecLabelTextStyle}"/><TextBlock Text="{Binding InternetPingText}" Style="{StaticResource PingMetricValue}"/><TextBlock Text="Average RTT" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/></StackPanel>
                    </Border>
                    <Border Style="{StaticResource PingMetricCard}">
                        <StackPanel><TextBlock Text="P95 LATENCY" Style="{StaticResource SpecLabelTextStyle}"/><TextBlock Text="{Binding InternetP95Text}" Style="{StaticResource PingMetricValue}"/><TextBlock Text="Tail latency" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/></StackPanel>
                    </Border>
                    <Border Style="{StaticResource PingMetricCard}">
                        <StackPanel><TextBlock Text="JITTER" Style="{StaticResource SpecLabelTextStyle}"/><TextBlock Text="{Binding InternetJitterText}" Style="{StaticResource PingMetricValue}"/><TextBlock Text="Sample-to-sample variation" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/></StackPanel>
                    </Border>
                    <Border Style="{StaticResource PingMetricCard}">
                        <StackPanel><TextBlock Text="PACKET LOSS" Style="{StaticResource SpecLabelTextStyle}"/><TextBlock Text="{Binding InternetLossText}" Style="{StaticResource PingMetricValue}"/><TextBlock Text="Lost probe percentage" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/></StackPanel>
                    </Border>
                </UniformGrid>

                <UniformGrid Columns="4" Margin="-4,2,-4,0">
                    <Border Style="{StaticResource PingMetricCard}" MinHeight="86">
                        <StackPanel><TextBlock Text="LOCAL HOP" Style="{StaticResource SpecLabelTextStyle}"/><TextBlock Text="{Binding LocalHopText}" FontSize="17" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="PC → router/gateway" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/></StackPanel>
                    </Border>
                    <Border Style="{StaticResource PingMetricCard}" MinHeight="86">
                        <StackPanel><TextBlock Text="DNS RESOLVER" Style="{StaticResource SpecLabelTextStyle}"/><TextBlock Text="{Binding DnsLookupText}" FontSize="17" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="OS resolver lookup time" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/></StackPanel>
                    </Border>
                    <Border Style="{StaticResource PingMetricCard}" MinHeight="86">
                        <StackPanel><TextBlock Text="ADAPTER MTU" Style="{StaticResource SpecLabelTextStyle}"/><TextBlock Text="{Binding MtuText}" FontSize="17" FontWeight="SemiBold" Margin="0,7,0,0"/><TextBlock Text="Active interface" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/></StackPanel>
                    </Border>
                    <Border Style="{StaticResource PingMetricCard}" MinHeight="86">
                        <StackPanel><TextBlock Text="ADAPTER COUNTERS" Style="{StaticResource SpecLabelTextStyle}"/><TextBlock Text="{Binding AdapterHealthText}" FontSize="14" FontWeight="SemiBold" Margin="0,7,0,0" TextWrapping="Wrap"/><TextBlock Text="Driver-reported since boot" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0"/></StackPanel>
                    </Border>
                </UniformGrid>

                <Border Style="{StaticResource SubtlePanelStyle}" Margin="4,10,4,0" Padding="12">
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Live monitor + optimizer -->
        <Grid Margin="0,14,0,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

            <Border Style="{StaticResource CardStyle}" Padding="20" CornerRadius="14">
                <StackPanel>
                    <TextBlock Text="LIVE INTERNET QUALITY" Style="{StaticResource EyebrowTextStyle}"/>
                    <TextBlock Text="Watch the path while you play" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock Text="Default target is 1.1.1.1, not your router, so a 0 ms local-gateway value cannot be mistaken for Internet/game ping."
                               Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    <UniformGrid Columns="3" Margin="-4,12,-4,0">
                        <Border Style="{StaticResource PingMetricCard}"><StackPanel><TextBlock Text="PING" Style="{StaticResource SpecLabelTextStyle}"/><TextBlock Text="{Binding LivePingText}" FontSize="19" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border>
                        <Border Style="{StaticResource PingMetricCard}"><StackPanel><TextBlock Text="JITTER" Style="{StaticResource SpecLabelTextStyle}"/><TextBlock Text="{Binding LiveJitterText}" FontSize="19" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border>
                        <Border Style="{StaticResource PingMetricCard}"><StackPanel><TextBlock Text="LOSS" Style="{StaticResource SpecLabelTextStyle}"/><TextBlock Text="{Binding LiveLossText}" FontSize="19" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border>
                    </UniformGrid>
                    <Grid Margin="4,10,4,0">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding LiveQuality}" Foreground="{DynamicResource TextPrimaryBrush}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="{Binding MonitorButtonText}" Command="{Binding ToggleMonitoringCommand}" Padding="15,8"/>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="20" CornerRadius="14">
                <StackPanel>
                    <TextBlock Text="LOCAL OPTIMIZER" Style="{StaticResource EyebrowTextStyle}"/>
                    <TextBlock Text="Tune, measure, keep only what helps" FontSize="18" FontWeight="SemiBold" Margin="0,5,0,0"/>
                    <TextBlock Text="The normal Optimize button avoids the most disruptive NIC options. Advanced latency mode is separate and benchmark-validated."
                               Margin="0,5,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    <WrapPanel Margin="0,14,0,0">
                        <Button Content="Optimize local path" Command="{Binding ApplyBestCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="17,9" Margin="0,0,8,8"/>
                        <Button Content="Advanced latency mode" Command="{Binding ApplyAdvancedLatencyCommand}" Padding="15,9" Margin="0,0,8,8"/>
                        <Button Content="Undo last optimization" Command="{Binding UndoLastOptimizationCommand}" IsEnabled="{Binding HasLastOptimization}" Padding="15,9" Margin="0,0,0,8"/>
                    </WrapPanel>
                    <Border Style="{StaticResource SubtlePanelStyle}" Margin="0,8,0,0" Padding="12">
                        <TextBlock Text="{Binding Comparison}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Region path comparison -->
        <Border Style="{StaticResource CardStyle}" Margin="0,14,0,0" Padding="20" CornerRadius="14">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="REGIONAL PATH ESTIMATE" Style="{StaticResource EyebrowTextStyle}"/>
                        <TextBlock Text="Compare nearby Internet regions" Margin="0,5,0,0" FontSize="18" FontWeight="SemiBold"/>
                        <TextBlock Text="Sabby uses actual ICMP/TCP network probes. Built-in targets are regional cloud endpoints, so treat the result as a route estimate—not a claim that the game server is at that address."
                                   Margin="0,6,20,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                    </StackPanel>
                    <Button Grid.Column="1" Content="Scan regions" Command="{Binding FindBestEndpointCommand}" Style="{StaticResource PrimaryButtonStyle}" Padding="16,9" VerticalAlignment="Center"/>
                </Grid>

                <Border Style="{StaticResource SubtlePanelStyle}" Margin="0,12,0,0" Padding="12">
                    <TextBlock Text="{Binding BestEndpointSummary}" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>

                <ItemsControl ItemsSource="{Binding RouteCandidates}" Margin="-4,8,-4,0">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource PingMetricCard}" MinHeight="126">
                                <StackPanel>
                                    <TextBlock Text="{Binding Badge}" Style="{StaticResource EyebrowTextStyle}"/>
                                    <TextBlock Text="{Binding Host}" Margin="0,6,0,0" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <TextBlock Text="{Binding Summary}" Margin="0,8,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>

        <!-- Measured quick-test details -->
        <ItemsControl ItemsSource="{Binding Results}" Margin="-4,10,-4,0">
            <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource PingMetricCard}">
                        <StackPanel>
                            <TextBlock Text="{Binding Rating}" Style="{StaticResource EyebrowTextStyle}"/>
                            <TextBlock Text="{Binding Target}" Margin="0,6,0,0" FontWeight="SemiBold"/>
                            <TextBlock Text="{Binding Summary}" Margin="0,7,0,0" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Advanced -->
        <Expander Margin="0,14,0,0">
            <Expander.Header>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Advanced network diagnostics" FontWeight="SemiBold"/>
                    <TextBlock Text="  •  route trace, custom targets, adapter details and Windows tools" Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
            </Expander.Header>
            <StackPanel Margin="0,12,0,0">
                <UniformGrid Columns="5" Margin="-4,0,-4,8">
                    <Border Style="{StaticResource PingMetricCard}"><StackPanel><TextBlock Text="ADAPTER" Style="{StaticResource SpecLabelTextStyle}"/><TextBlock Text="{Binding AdapterName}" Style="{StaticResource SpecValueTextStyle}" FontSize="12"/></StackPanel></Border>
                    <Border Style="{StaticResource PingMetricCard}"><StackPanel><TextBlock Text="LINK" Style="{StaticResource SpecLabelTextStyle}"/><TextBlock Text="{Binding LinkSpeed}" Style="{StaticResource SpecValueTextStyle}" FontSize="12"/></StackPanel></Border>
                    <Border Style="{StaticResource PingMetricCard}"><StackPanel><TextBlock Text="LOCAL IP" Style="{StaticResource SpecLabelTextStyle}"/><TextBlock Text="{Binding LocalAddress}" Style="{StaticResource SpecValueTextStyle}" FontSize="12"/></StackPanel></Border>
                    <Border Style="{StaticResource PingMetricCard}"><StackPanel><TextBlock Text="GATEWAY" Style="{StaticResource SpecLabelTextStyle}"/><TextBlock Text="{Binding Gateway}" Style="{StaticResource SpecValueTextStyle}" FontSize="12"/></StackPanel></Border>
                    <Border Style="{StaticResource PingMetricCard}"><StackPanel><TextBlock Text="TCP CONNECTIONS" Style="{StaticResource SpecLabelTextStyle}"/><TextBlock Text="{Binding TcpConnectionsText}" Style="{StaticResource SpecValueTextStyle}" FontSize="12"/></StackPanel></Border>
                </UniformGrid>

                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="12"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Border Style="{StaticResource CardStyle}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Custom target / endpoint" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="Use an IP/hostname you actually care about. Region list format: Name=host:port; Name=host:port."
                                       Margin="0,5,0,0" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                            <TextBlock Text="Single target" Margin="0,10,0,0" Style="{StaticResource FieldLabelTextStyle}"/>
                            <TextBox Text="{Binding CustomHost, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0"/>
                            <TextBlock Text="Region/server list" Margin="0,10,0,0" Style="{StaticResource FieldLabelTextStyle}"/>
                            <TextBox Text="{Binding CandidateHosts, UpdateSourceTrigger=PropertyChanged}" Margin="0,5,0,0" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="68"/>
                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="Test targets" Command="{Binding RunTestsCommand}" Margin="0,0,8,8"/>
                                <Button Content="Analyze region list" Command="{Binding FindBestEndpointCommand}" Margin="0,0,8,8"/>
                                <Button Content="Trace route" Command="{Binding TraceRouteCommand}" Margin="0,0,0,8"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="16">
                        <StackPanel>
                            <TextBlock Text="Diagnostics" FontSize="14" FontWeight="SemiBold"/>
                            <TextBlock Text="DNS servers" Margin="0,10,0,0" Style="{StaticResource SpecLabelTextStyle}"/>
                            <TextBlock Text="{Binding DnsServers}" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <TextBlock Text="Route trace" Margin="0,12,0,0" Style="{StaticResource SpecLabelTextStyle}"/>
                            <TextBlock Text="{Binding RouteTraceText}" Margin="0,4,0,0" TextWrapping="Wrap" FontFamily="Cascadia Mono" FontSize="11.5" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            <WrapPanel Margin="0,12,0,0">
                                <Button Content="Flush DNS cache" Command="{Binding FlushDnsCommand}" Margin="0,0,8,8"/>
                                <Button Content="Open Windows network settings" Command="{Binding OpenNetworkSettingsCommand}" Margin="0,0,0,8"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Border Style="{StaticResource SubtlePanelStyle}" Margin="0,10,0,0" Padding="12">
                    <TextBlock Text="Sabby can measure and tune the local Windows/NIC path, but it does not run a relay/VPN network. It cannot honestly replace ISP routing or an external multipath relay service."
                               Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                </Border>
            </StackPanel>
        </Expander>
    </StackPanel>
</UserControl>
