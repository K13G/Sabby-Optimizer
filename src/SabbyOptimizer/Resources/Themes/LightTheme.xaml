<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F4F6F9" />
    <SolidColorBrush x:Key="SidebarBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#F0F3F7" />
    <SolidColorBrush x:Key="BorderBrush" Color="#D5DDE7" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#17202A" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#52606D" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#7D8894" />
    <Color x:Key="BrandAccentColor">#246FDB</Color>
    <Color x:Key="AccentColor">#246FDB</Color>
    <Color x:Key="AccentHoverColor">#1D5FBE</Color>
    <Color x:Key="AccentSubtleColor">#E5EEF9</Color>
    <Color x:Key="CardBorderColor">#3D246FDB</Color>
    <Color x:Key="AccentGlowColor">#4D246FDB</Color>
    <Color x:Key="AccentGradientStartColor">#246FDB</Color>
    <Color x:Key="AccentGradientEndColor">#3D9AE8</Color>
    <SolidColorBrush x:Key="BrandAccentBrush" Color="{DynamicResource BrandAccentColor}" />
    <SolidColorBrush x:Key="AccentBrush" Color="{DynamicResource AccentColor}" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{DynamicResource AccentHoverColor}" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="{DynamicResource AccentSubtleColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{DynamicResource CardBorderColor}" />
    <SolidColorBrush x:Key="AccentGlowBrush" Color="{DynamicResource AccentGlowColor}" />
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0.5" EndPoint="1,0.5">
        <GradientStop Color="{DynamicResource AccentGradientStartColor}" Offset="0" />
        <GradientStop Color="{DynamicResource AccentGradientEndColor}" Offset="1" />
    </LinearGradientBrush>
</ResourceDictionary>